<file path="components/input/CustomUpload.js">
"use client";
// src/components/input/CustomUpload.js

import { useEffect, useId, useRef, useState } from "react";
import styles from "./CustomInput.module.css";

function formatSize(bytes) {
  if (bytes < 1024 * 1024) return `${(bytes / 1024).toFixed(0)} KB`;
  return `${(bytes / (1024 * 1024)).toFixed(2)} MB`;
}

export default function CustomUpload({
  label,
  preview = false,
  maxSize, // in MB, e.g. maxSize={1}
  buttonText = "Choose file",
  placeholder = "No file chosen",
  className = "",
  id,
  value, // optional File (or null) controlled by the parent
  onFileChange, // called with the File, or null when cleared
  onChange,
  ...props
}) {
  const autoId = useId();
  const inputId = id || autoId;
  const inputRef = useRef(null);
  const [file, setFile] = useState(null);
  const [previewUrl, setPreviewUrl] = useState(null);
  const [error, setError] = useState("");

  const isImage = !!file && file.type.startsWith("image/");
  const isPdf = !!file && file.type === "application/pdf";

  // Put a file back into the hidden native input, so `required` stays valid.
  const syncInput = (f) => {
    const input = inputRef.current;
    if (!input) return;
    try {
      const dt = new DataTransfer();
      if (f) dt.items.add(f);
      input.files = dt.files;
    } catch {
      if (!f) input.value = "";
    }
  };

  // Controlled mode: when the parent hands us a different file (for example one
  // restored from IndexedDB), show it AND put it in the native input, so that
  // `required` validation passes without the user picking the file again.
  useEffect(() => {
    if (value === undefined || value === file) return;
    setFile(value);
    setError("");
    syncInput(value);
    // eslint-disable-next-line react-hooks/exhaustive-deps
  }, [value]);

  // Build / clean up the preview URL for images and PDFs.
  useEffect(() => {
    if (!preview || !file || (!isImage && !isPdf)) {
      setPreviewUrl(null);
      return;
    }
    const url = URL.createObjectURL(file);
    setPreviewUrl(url);
    return () => URL.revokeObjectURL(url);
  }, [file, preview, isImage, isPdf]);

  const handleChange = (e) => {
    const selected = e.target.files?.[0] ?? null;

    // Too large: show the error but KEEP the previous file (state, input, draft).
    if (selected && maxSize && selected.size > maxSize * 1024 * 1024) {
      setError(
        `File is too large (${formatSize(selected.size)}). Max size is ${maxSize} MB.`,
      );
      syncInput(file);
      return;
    }

    setError("");
    setFile(selected);
    onFileChange?.(selected);
    onChange?.(e);
  };

  const handleRemove = () => {
    syncInput(null);
    setFile(null);
    setError("");
    onFileChange?.(null); // keep the parent in sync
  };

  return (
    <div className={styles.wrapper}>
      {label && (
        <label className={styles.label} htmlFor={inputId}>
          {label}
        </label>
      )}

      <div
        className={`${styles.fileBox} ${error ? styles.fileBoxError : ""} ${className}`.trim()}
      >
        <div className={styles.fileInfo}>
          <span
            className={`${styles.fileName} ${!file ? styles.filePlaceholder : ""}`}
          >
            {file ? file.name : placeholder}
          </span>
          {file && (
            <span className={styles.fileSize}>{formatSize(file.size)}</span>
          )}
        </div>

        <button
          type="button"
          className={styles.fileBtn}
          onClick={() => inputRef.current?.click()}
        >
          {buttonText}
        </button>

        <input
          ref={inputRef}
          id={inputId}
          type="file"
          className={styles.fileNative}
          onChange={handleChange}
          tabIndex={-1}
          {...props}
        />
      </div>

      {error && (
        <p className={styles.errorText} role="alert">
          {error}
        </p>
      )}

      {preview && file && (
        <div
          className={`${styles.previewBox} ${isPdf ? styles.previewBoxPdf : ""}`.trim()}
        >
          {/* Image preview */}
          {previewUrl && isImage && (
            <img src={previewUrl} alt="Preview" className={styles.previewImg} />
          )}

          {/* PDF preview */}
          {previewUrl && isPdf && (
            <div className={styles.pdfWrap}>
              <iframe
                src={`${previewUrl}#toolbar=0&navpanes=0`}
                title={`Preview of ${file.name}`}
                className={styles.previewPdf}
              />
              <a
                href={previewUrl}
                target="_blank"
                rel="noopener noreferrer"
                className={styles.pdfLink}
              >
                Open PDF in new tab
              </a>
            </div>
          )}

          {/* Fallback card for other file types */}
          {!isImage && !isPdf && (
            <div className={styles.previewFile}>
              <span className={styles.previewFileName}>{file.name}</span>
              <span className={styles.previewFileSize}>
                {formatSize(file.size)}
              </span>
            </div>
          )}

          <button
            type="button"
            className={styles.removeBtn}
            onClick={handleRemove}
          >
            Remove
          </button>
        </div>
      )}
    </div>
  );
}
</file>

<file path="components/input/DatePicker.js">
"use client";
// src/components/input/DatePicker.js
// Custom calendar popover (the browser's own date popup can't be styled).
//
//   value               "YYYY-MM-DD" or ""
//   onChange            called with { target: { name, value } }, so it works
//                       with the same setField(...) handlers as CustomInput
//   min / max           days before min or after max are disabled
//   rangeStart/rangeEnd the highlighted range (circles on both ends, a band
//                       between them). Pass the SAME two values to both pickers.
import { useCallback, useEffect, useId, useRef, useState } from "react";
import baseStyles from "./CustomInput.module.css";
import styles from "./DatePicker.module.css";
import useDismiss from "./useDismiss";
import { formatDate } from "@/lib/format";
import {
  WEEKDAYS,
  addDays,
  addMonths,
  clampISO,
  isDisabled,
  longLabel,
  monthCells,
  monthLabel,
  monthOf,
  parseISO,
  toISO,
  todayISO,
} from "@/lib/calendar";

function Chevron({ dir }) {
  return (
    <svg
      width="16"
      height="16"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      strokeWidth="2.5"
      strokeLinecap="round"
      strokeLinejoin="round"
      aria-hidden="true"
    >
      <path d={dir === "left" ? "M15 6l-6 6 6 6" : "M9 6l6 6-6 6"} />
    </svg>
  );
}

function CalendarIcon() {
  return (
    <svg
      className={styles.icon}
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      strokeWidth="2"
      strokeLinecap="round"
      strokeLinejoin="round"
      aria-hidden="true"
    >
      <rect x="3" y="5" width="18" height="16" rx="3" />
      <path d="M3 10h18M8 3v4M16 3v4" />
    </svg>
  );
}

export default function DatePicker({
  label,
  name,
  value = "",
  onChange,
  min,
  max,
  rangeStart,
  rangeEnd,
  placeholder = "Select a date",
  error,
  required,
}) {
  const id = useId();
  const rootRef = useRef(null);
  const triggerRef = useRef(null);
  const gridRef = useRef(null);
  const shouldFocus = useRef(false); // only move focus for open + arrow keys

  const [open, setOpen] = useState(false);
  const [view, setView] = useState(null); // { y, m } of the month being shown
  const [focusIso, setFocusIso] = useState(null); // the one tabbable day

  const close = useCallback(() => setOpen(false), []);
  useDismiss(open, rootRef, close);

  function openCalendar() {
    // Open on the selected date, else on the other date of the range, else today.
    const anchor = [value, rangeStart, rangeEnd, todayISO()].find((v) =>
      parseISO(v),
    );
    const start = clampISO(anchor, min, max);
    shouldFocus.current = true;
    setView(monthOf(start));
    setFocusIso(start);
    setOpen(true);
  }

  // Move keyboard focus onto the focused day (after open, or an arrow key).
  useEffect(() => {
    if (!open || !focusIso || !shouldFocus.current) return;
    const el = gridRef.current?.querySelector(`[data-iso="${focusIso}"]`);
    if (el) {
      el.focus();
      shouldFocus.current = false;
    }
  }, [open, focusIso, view]);

  function pick(iso) {
    if (isDisabled(iso, min, max)) return;
    onChange?.({ target: { name, value: iso } });
    setOpen(false);
    triggerRef.current?.focus();
  }

  function clear() {
    onChange?.({ target: { name, value: "" } });
    setOpen(false);
    triggerRef.current?.focus();
  }

  function goToMonth(delta) {
    const next = addMonths(view, delta);
    setView(next);
    setFocusIso(toISO(next.y, next.m, 1)); // keeps one tabbable day, no focus jump
  }

  function onGridKeyDown(e) {
    const step = { ArrowLeft: -1, ArrowRight: 1, ArrowUp: -7, ArrowDown: 7 }[
      e.key
    ];
    if (step === undefined || !focusIso) return;
    e.preventDefault();
    shouldFocus.current = true;
    const next = addDays(focusIso, step);
    setFocusIso(next);
    const m = monthOf(next);
    if (m.y !== view.y || m.m !== view.m) setView(m);
  }

  function onRootKeyDown(e) {
    if (e.key === "Escape" && open) {
      e.stopPropagation();
      setOpen(false);
      triggerRef.current?.focus();
    }
  }

  const today = open ? todayISO() : "";
  const cells = open && view ? monthCells(view) : [];
  const hasRange = Boolean(
    parseISO(rangeStart) && parseISO(rangeEnd) && rangeStart < rangeEnd,
  );

  return (
    <div className={baseStyles.wrapper}>
      {label && (
        <label className={baseStyles.label} htmlFor={id}>
          {label}
        </label>
      )}

      <div
        className={baseStyles.inputContainer}
        ref={rootRef}
        onKeyDown={onRootKeyDown}
      >
        <button
          type="button"
          id={id}
          ref={triggerRef}
          className={`${baseStyles.input} ${styles.trigger}`}
          style={error ? { borderColor: "#ff3b30" } : undefined}
          onClick={() => (open ? setOpen(false) : openCalendar())}
          aria-haspopup="dialog"
          aria-expanded={open}
          aria-required={required || undefined}
        >
          <span className={value ? styles.value : styles.placeholder}>
            {value ? formatDate(value) : placeholder}
          </span>
          <CalendarIcon />
        </button>

        {/* Lets the value travel with a normal <form> too. */}
        <input type="hidden" name={name} value={value ?? ""} />

        {open && view && (
          <div
            className={styles.popover}
            role="dialog"
            aria-label={label ? `Choose ${label}` : "Choose a date"}
          >
            <div className={styles.header}>
              <button
                type="button"
                className={styles.navBtn}
                onClick={() => goToMonth(-1)}
                aria-label="Previous month"
              >
                <Chevron dir="left" />
              </button>
              <span className={styles.title} aria-live="polite">
                {monthLabel(view)}
              </span>
              <button
                type="button"
                className={styles.navBtn}
                onClick={() => goToMonth(1)}
                aria-label="Next month"
              >
                <Chevron dir="right" />
              </button>
            </div>

            <div className={styles.weekdays} aria-hidden="true">
              {WEEKDAYS.map((d) => (
                <span key={d}>{d}</span>
              ))}
            </div>

            <div
              className={styles.grid}
              ref={gridRef}
              onKeyDown={onGridKeyDown}
            >
              {cells.map((iso, i) => {
                if (!iso)
                  return <span key={`blank-${i}`} className={styles.cell} />;

                const day = parseISO(iso).d;
                const col = i % 7;
                const isStart = iso === rangeStart;
                const isEnd = iso === rangeEnd;
                const selected = isStart || isEnd || iso === value;
                const inRange = hasRange && iso > rangeStart && iso < rangeEnd;
                const disabled = isDisabled(iso, min, max);

                const cellCls = [
                  styles.cell,
                  inRange && styles.inRange,
                  // round the band where a row (or the month) begins/ends
                  inRange && (col === 0 || day === 1) && styles.roundL,
                  inRange &&
                    (col === 6 || i === cells.length - 1) &&
                    styles.roundR,
                  // half-band joining the start / end circle to the range
                  hasRange && isStart && styles.capStart,
                  hasRange && isEnd && styles.capEnd,
                ]
                  .filter(Boolean)
                  .join(" ");

                const dayCls = [
                  styles.day,
                  selected && styles.selected,
                  iso === today && !selected && styles.today,
                  disabled && styles.disabled,
                ]
                  .filter(Boolean)
                  .join(" ");

                return (
                  <span key={iso} className={cellCls}>
                    <button
                      type="button"
                      className={dayCls}
                      data-iso={iso}
                      tabIndex={iso === focusIso ? 0 : -1}
                      aria-label={longLabel(iso)}
                      aria-pressed={selected}
                      aria-disabled={disabled || undefined}
                      aria-current={iso === today ? "date" : undefined}
                      onClick={() => pick(iso)}
                      onFocus={() => setFocusIso(iso)}
                    >
                      {day}
                    </button>
                  </span>
                );
              })}
            </div>

            <div className={styles.footer}>
              <button type="button" className={styles.linkBtn} onClick={clear}>
                Clear
              </button>
              <button
                type="button"
                className={styles.linkBtn}
                aria-disabled={isDisabled(today, min, max) || undefined}
                onClick={() => pick(today)}
              >
                Today
              </button>
            </div>
          </div>
        )}
      </div>

      <p className={baseStyles.errorText} role={error ? "alert" : undefined}>
        {error || ""}
      </p>
    </div>
  );
}
</file>

<file path="components/input/DatePicker.module.css">
/* src/components/input/DatePicker.module.css
   Calendar popover for DatePicker.js. The trigger button reuses the `.input`
   look from CustomInput.module.css. Remember globals.css sets
   `button { all: unset }`, so every button below sets its own display. */

.trigger {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    text-align: left;
    cursor: pointer;
}

.value {
    color: #333;
}

.placeholder {
    color: #9ca3af;
    font-weight: 500;
}

.icon {
    flex-shrink: 0;
    color: #666;
    opacity: 0.7;
}

/* ---- Popover ---- */

.popover {
    --range-bg: #e3e9f4;
    /* band between start and end */

    position: absolute;
    z-index: 20;
    top: calc(100% + 8px);
    left: 0;
    box-sizing: border-box;
    width: 100%;
    min-width: 292px;
    max-width: 340px;
    padding: 16px;
    background-color: var(--light);
    border: 1px solid #e5e7eb;
    border-radius: 20px;
    box-shadow: 0 12px 32px rgba(17, 24, 39, 0.14);
    animation: pop 0.14s ease-out;
}

@keyframes pop {
    from {
        opacity: 0;
        transform: translateY(-4px);
    }
}

@media (prefers-reduced-motion: reduce) {
    .popover {
        animation: none;
    }
}

/* ---- Header ---- */

.header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 12px;
}

.title {
    font-size: 15px;
    font-weight: 600;
    color: var(--primary);
}

.navBtn {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    border-radius: 50%;
    color: var(--dark);
    cursor: pointer;
    transition: background-color 0.15s ease;
}

.navBtn:hover {
    background-color: #f1f3f7;
}

/* ---- Weekday row + day grid ---- */

.weekdays,
.grid {
    display: grid;
    grid-template-columns: repeat(7, 1fr);
}

.weekdays {
    margin-bottom: 4px;
}

.weekdays span {
    padding: 6px 0;
    font-size: 12px;
    font-weight: 600;
    text-align: center;
    color: #9ca3af;
}

.cell {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 40px;
}

/* ---- Range band ---- */

.inRange {
    background-color: var(--range-bg);
}

.roundL {
    border-radius: 999px 0 0 999px;
}

.roundR {
    border-radius: 0 999px 999px 0;
}

.roundL.roundR {
    border-radius: 999px;
}

/* Half a band behind the start / end circle so the range looks continuous */
.capStart {
    background: linear-gradient(to right, transparent 50%, var(--range-bg) 50%);
}

.capEnd {
    background: linear-gradient(to left, transparent 50%, var(--range-bg) 50%);
}

/* ---- Day circle ---- */

.day {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    font-size: 13px;
    font-weight: 500;
    color: var(--dark);
    cursor: pointer;
    transition: background-color 0.15s ease, color 0.15s ease;
}

.day:hover {
    background-color: #eef1f6;
}

.day:focus-visible {
    outline: 2px solid var(--primary);
    outline-offset: 2px;
}

.today {
    box-shadow: inset 0 0 0 1.5px var(--primary);
    color: var(--primary);
    font-weight: 600;
}

/* Start / end (and the picked value): solid circle */
.selected,
.selected:hover {
    background-color: var(--primary);
    color: var(--light);
    font-weight: 600;
}

.disabled,
.disabled:hover {
    background-color: transparent;
    color: #c9ccd3;
    cursor: not-allowed;
}

/* ---- Footer ---- */

.footer {
    display: flex;
    justify-content: space-between;
    margin-top: 10px;
    padding-top: 10px;
    border-top: 1px solid #eef0f4;
}

.linkBtn {
