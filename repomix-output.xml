<file path="lib/inventory.js">
import {
  addDoc,
  collection,
  doc,
  getDoc,
  onSnapshot,
  orderBy,
  query,
  serverTimestamp,
  updateDoc,
} from "firebase/firestore";
import { db } from "./firebase";

/* ------------------------------------------------------------------ */
/* Products live at organizations/{orgId}/products                     */
/* Money is integer sen, same as transactions: RM 12.50 = 1250         */
/* ------------------------------------------------------------------ */

export const PRODUCT_CATEGORIES = ["Food", "Drinks", "Household"];

export function senToRM(sen) {
  return (sen ?? 0) / 100;
}

export function mapProduct(id, data) {
  return {
    id,
    name: data.name ?? "-",
    stock: data.stock ?? 0,
    category: data.category ?? "Other",
    cost: senToRM(data.cost),
    price: senToRM(data.price),
    dueDate: data.dueDate ?? "", // "YYYY-MM-DD", only used for Food
    barcode: data.barcode ?? "",
    imageUrl: data.imageUrl ?? null,
  };
}

function isVisible(data) {
  return !data.deletedAt;
}

/** Live product list, alphabetical. */
export function subscribeProducts(orgId, callback) {
  const q = query(
    collection(db, "organizations", orgId, "products"),
    orderBy("name"),
  );
  return onSnapshot(
    q,
    (snap) => {
      const items = [];
      snap.forEach((d) => {
        const data = d.data();
        if (!isVisible(data)) return;
        items.push(mapProduct(d.id, data));
      });
      callback(items);
    },
    (err) => console.error("Products listener failed:", err),
  );
}

/** One-time read of a single product (detail page). */
export async function getProduct(orgId, productId) {
  const snap = await getDoc(
    doc(db, "organizations", orgId, "products", productId),
  );
  if (!snap.exists()) return null;
  const data = snap.data();
  if (!isVisible(data)) return null;
  return mapProduct(snap.id, data);
}

/** Add a new product. cost/price arrive in RM and are stored as sen. */
export async function addProduct({ orgId, user, product }) {
  await addDoc(collection(db, "organizations", orgId, "products"), {
    name: product.name.trim(),
    stock: Number(product.stock),
    category: product.category,
    cost: Math.round(product.cost * 100),
    price: Math.round(product.price * 100),
    dueDate: product.category === "Food" ? product.dueDate : null,
    barcode: product.barcode?.trim() ?? "",
    imageUrl: product.imageUrl ?? null,
    createdBy: user.uid,
    createdAt: serverTimestamp(),
    updatedAt: serverTimestamp(),
  });
}

/** Save edited fields on an existing product. */
export async function updateProduct({ orgId, productId, product }) {
  await updateDoc(doc(db, "organizations", orgId, "products", productId), {
    name: product.name.trim(),
    stock: Number(product.stock),
    category: product.category,
    cost: Math.round(product.cost * 100),
    price: Math.round(product.price * 100),
    dueDate: product.category === "Food" ? product.dueDate : null,
    barcode: product.barcode?.trim() ?? "",
    updatedAt: serverTimestamp(),
  });
}

/** Soft delete: hidden from all queries, recoverable in Firestore. */
export async function deleteProduct({ orgId, productId }) {
  await updateDoc(doc(db, "organizations", orgId, "products", productId), {
    deletedAt: serverTimestamp(),
    updatedAt: serverTimestamp(),
  });
}
</file>

<file path="lib/onboarding.js">
import {
  createUserWithEmailAndPassword,
  updateProfile,
} from "firebase/auth";
import {
  collection,
  doc,
  getDoc,
  serverTimestamp,
  setDoc,
  writeBatch,
} from "firebase/firestore";
import { auth, db } from "./firebase";

// No 0/O/1/I so codes are easy to read out loud
const CODE_ALPHABET = "ABCDEFGHJKLMNPQRSTUVWXYZ23456789";

function generateInviteCode(length = 8) {
  const bytes = crypto.getRandomValues(new Uint8Array(length));
  return Array.from(bytes, (b) => CODE_ALPHABET[b % CODE_ALPHABET.length]).join("");
}

/** Step 1 (/onboarding): Auth account + users/{uid} profile doc. */
export async function registerUser({ name, email, password }) {
  const cred = await createUserWithEmailAndPassword(auth, email, password);
  await updateProfile(cred.user, { displayName: name });

  await setDoc(doc(db, "users", cred.user.uid), {
    name,
    email: email.toLowerCase(),
    photoUrl: null,
    orgId: null,
    role: null,
    onboardingCompleted: false,
    language: "en",
    createdAt: serverTimestamp(),
    updatedAt: serverTimestamp(),
    lastLoginAt: serverTimestamp(),
  });
  return cred.user;
}

/** Step 2a (/onboarding/welcome): join an existing org with an invite code. */
export async function joinOrganization({ user, code }) {
  const cleanCode = code.trim().toUpperCase();
  const codeSnap = await getDoc(doc(db, "orgCodes", cleanCode));
  if (!codeSnap.exists()) throw new Error("INVALID_CODE");

  const { orgId, active, expiresAt } = codeSnap.data();
  if (!active || (expiresAt && expiresAt.toMillis() < Date.now())) {
    throw new Error("CODE_EXPIRED");
  }

  const batch = writeBatch(db);
  batch.set(doc(db, "organizations", orgId, "members", user.uid), {
    role: "staff",
    name: user.displayName ?? "",
    email: user.email,
    joinedAt: serverTimestamp(),
    invitedVia: cleanCode,
    status: "active",
  });
  batch.update(doc(db, "users", user.uid), {
    orgId,
    role: "staff",
    onboardingCompleted: true,
    updatedAt: serverTimestamp(),
  });
  await batch.commit();
  return orgId;
}

/** Step 2b/3 (/organization + /sales): create the org. One atomic batch. */
export async function createOrganization({
  user,
  name,
  businessType,
  monthlySalesRM,
}) {
  const orgRef = doc(collection(db, "organizations"));
  const inviteCode = generateInviteCode();

  const batch = writeBatch(db);
  batch.set(orgRef, {
    name,
    ownerUid: user.uid,
    businessType,
    avgMonthlySales: Math.round(monthlySalesRM * 100), // integer sen
    settings: {
      currency: "MYR",
      timezone: "Asia/Kuala_Lumpur",
      lowStockThreshold: 5,
      expiryAlertDays: 7,
    },
    memberCount: 1,
    inviteCode,
    createdAt: serverTimestamp(),
    updatedAt: serverTimestamp(),
  });
  batch.set(doc(db, "organizations", orgRef.id, "members", user.uid), {
    role: "owner",
    name: user.displayName ?? "",
    email: user.email,
    joinedAt: serverTimestamp(),
    invitedVia: null,
    status: "active",
  });
  batch.set(doc(db, "orgCodes", inviteCode), {
    orgId: orgRef.id,
    createdBy: user.uid,
    active: true,
    expiresAt: null,
    defaultRole: "staff",
    uses: 0,
    createdAt: serverTimestamp(),
  });
  batch.update(doc(db, "users", user.uid), {
    orgId: orgRef.id,
    role: "owner",
    onboardingCompleted: true,
    updatedAt: serverTimestamp(),
  });
  await batch.commit();
  return orgRef.id;
}
</file>

