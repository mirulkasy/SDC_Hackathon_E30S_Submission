"use client";

import { useEffect, useRef, useState } from "react";
import Image from "next/image";
import AppBar from "@/components/layout/AppBar";
import styles from "./chat.module.css";

const GREETINGS = [
  "How can we help you?",
  "What are you working on today?",
  "Ready when you are",
  "What would you like to do?",
  "Ask us anything",
];

const SUGGESTIONS = [
  { id: "spreadsheet", label: "Make a spreadsheet" },
  { id: "products", label: "Search for products" },
  { id: "summarise", label: "Summarise a document" },
];

function SuggestionIcon({ id }) {
  const icons = {
    spreadsheet: (
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        strokeWidth="1.5"
        stroke="currentColor"
        width={22}
        height={22}
      >
        <path
          strokeLinecap="round"
          strokeLinejoin="round"
          d="M3.375 19.5h17.25m-17.25 0a1.125 1.125 0 0 1-1.125-1.125M3.375 19.5h7.5c.621 0 1.125-.504 1.125-1.125m-9.75 0V5.625c0-.621.504-1.125 1.125-1.125h18.75c.621 0 1.125.504 1.125 1.125v12.75m-21.75 0a1.125 1.125 0 0 0 1.125 1.125m20.625 0a1.125 1.125 0 0 1-1.125-1.125m-8.25-9.75h3.375c.621 0 1.125.504 1.125 1.125v3.375c0 .621-.504 1.125-1.125 1.125H12.75m-3.75-4.5v4.5m4.5-4.5h3m-3 2.25h3m-3 2.25h3m-7.5 0H9m3.75 0H9"
        />
      </svg>
    ),
    products: (
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        strokeWidth="1.5"
        stroke="currentColor"
        width={22}
        height={22}
      >
        <path
          strokeLinecap="round"
          strokeLinejoin="round"
          d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"
        />
      </svg>
    ),
    summarise: (
      <svg
        xmlns="http://www.w3.org/2000/svg"
        fill="none"
        viewBox="0 0 24 24"
        strokeWidth="1.5"
        stroke="currentColor"
        width={22}
        height={22}
      >
        <path
          strokeLinecap="round"
          strokeLinejoin="round"
          d="M19.5 14.25v-2.625a3.375 3.375 0 0 0-3.375-3.375h-1.5A1.125 1.125 0 0 1 13.5 7.125v-1.5a3.375 3.375 0 0 0-3.375-3.375H8.25m0 12.75h7.5m-7.5 3H12M10.5 2.25H5.625c-.621 0-1.125.504-1.125 1.125v17.25c0 .621.504 1.125 1.125 1.125h12.75c.621 0 1.125-.504 1.125-1.125V11.25a9 9 0 0 0-9-9Z"
        />
      </svg>
    ),
  };
  return icons[id] ?? icons.products;
}

export default function ChatPage() {
  const [greeting, setGreeting] = useState(GREETINGS[0]);
  const [message, setMessage] = useState("");
  const [attachments, setAttachments] = useState([]);
  const fileInputRef = useRef(null);

  // Randomise after mount so server and client HTML match (no hydration error)
  useEffect(() => {
    setGreeting(GREETINGS[Math.floor(Math.random() * GREETINGS.length)]);
  }, []);

  const canSend = message.trim().length > 0 || attachments.length > 0;

  function handleNewChat() {
    setMessage("");
    setAttachments([]);
    setGreeting(GREETINGS[Math.floor(Math.random() * GREETINGS.length)]);
    // TODO: clear conversation state from the AI model here
  }

  function handleFiles(event) {
    const picked = Array.from(event.target.files || []);
    setAttachments((prev) => [...prev, ...picked]);
    event.target.value = ""; // allow re-picking the same file
  }

  function removeAttachment(index) {
    setAttachments((prev) => prev.filter((_, i) => i !== index));
  }

  function handleSend() {
    if (!canSend) return;
    // TODO: send { text: message, files: attachments } to teammate's AI model
    console.log({ text: message, files: attachments });
    setMessage("");
    setAttachments([]);
  }

  function handleKeyDown(event) {
    if (event.key === "Enter" && !event.shiftKey) {
      event.preventDefault();
      handleSend();
    }
  }

  return (
    <>
      {/* ── Section 1: Top bar (same AppBar as every other page) ── */}
      <AppBar
        title="Biscoach AI"
        actionIcon={
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            strokeWidth="1.5"
            stroke="currentColor"
            width={22}
            height={22}
          >
            <path
              strokeLinecap="round"
              strokeLinejoin="round"
              d="M16.862 4.487l1.687-1.688a1.875 1.875 0 1 1 2.652 2.652L6.832 19.82a4.5 4.5 0 0 1-1.897 1.13l-2.685.8.8-2.685a4.5 4.5 0 0 1 1.13-1.897L16.863 4.487Zm0 0L19.5 7.125"
            />
          </svg>
        }
        onAction={handleNewChat}
      />

      <main className={styles.chatPage}>
        {/* ── Section 2: Mascot & greeting ── */}
        <section className={styles.mascotSection}>
          <div className={styles.mascot}>
            <Image
              src="/assets/biscoach/think.png"
              alt="Biscoach mascot"
              width={180}
              height={180}
            />
            <h1>{greeting}</h1>
          </div>
        </section>

        {/* ── Section 3: Suggestions ── */}
        <section className={styles.suggestSection}>
          <div className={styles.suggestGrid}>
            {SUGGESTIONS.map((item) => (
              <button
                key={item.id}
                type="button"
                className={styles.suggestItem}
                onClick={() => setMessage(item.label)}
              >
                <span className={styles.suggestIcon}>
                  <SuggestionIcon id={item.id} />
                </span>
                <p>{item.label}</p>
              </button>
            ))}
          </div>
        </section>

        {/* ── Section 4: Chat box ── */}
        <section className={styles.chatBoxSection}>
          {attachments.length > 0 && (
            <div className={styles.attachmentList}>
              {attachments.map((file, index) => (
                <button
                  key={`${file.name}-${index}`}
                  type="button"
                  className={styles.attachmentChip}
                  onClick={() => removeAttachment(index)}
                  aria-label={`Remove ${file.name}`}
                >
                  <span>{file.name}</span>
                  <span aria-hidden="true">&times;</span>
                </button>
              ))}
            </div>
          )}

          <div className={styles.chatBox}>
            <input
              ref={fileInputRef}
              type="file"
              multiple
              hidden
              onChange={handleFiles}
            />
            <button
              type="button"
              className={styles.addButton}
              onClick={() => fileInputRef.current?.click()}
              aria-label="Add images or files"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                strokeWidth="2"
                stroke="currentColor"
                width={22}
                height={22}
              >
                <path
                  strokeLinecap="round"
                  strokeLinejoin="round"
                  d="M12 4.5v15m7.5-7.5h-15"
                />
              </svg>
            </button>

            <input
              type="text"
              className={styles.chatInput}
              placeholder="Ask me anything"
              value={message}
              onChange={(e) => setMessage(e.target.value)}
              onKeyDown={handleKeyDown}
            />

            <button
              type="button"
              className={styles.sendButton}
              onClick={handleSend}
              disabled={!canSend}
              aria-label="Send message"
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                strokeWidth="2"
                stroke="currentColor"
                width={20}
                height={20}
              >
                <path
                  strokeLinecap="round"
                  strokeLinejoin="round"
                  d="M13.5 4.5 21 12m0 0-7.5 7.5M21 12H3"
                />
              </svg>
            </button>
          </div>
        </section>
      </main>
    </>
  );
}
