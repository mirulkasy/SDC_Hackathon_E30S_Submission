        <h1>
          Create Your
          <br />
          Team’s Workspace
        </h1>
        <form
          className={styles.organizationForm}
          onSubmit={(e) => {
            e.preventDefault();
            handleNext();
          }}
        >
          <CustomInput
            label={"Organization Name"}
            name="orgName"
            autoComplete="organization"
            value={draft.orgName}
            onChange={(e) =>
              setDraft((d) => ({ ...d, orgName: e.target.value }))
            }
            error={error}
          />
          <p>
