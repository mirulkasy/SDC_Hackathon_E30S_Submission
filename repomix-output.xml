<file path="lib/transactions.js">
import {
  Timestamp,
  collection,
  doc,
  addDoc,
  serverTimestamp,
  getDoc,
  getDocs,
  onSnapshot,
  query,
  where,
  orderBy,
  limit,
} from "firebase/firestore";
import { db } from "./firebase";

/* ------------------------------------------------------------------ */
/* Money — schema stores integer sen: RM 12.50 = 1250                  */
/* ------------------------------------------------------------------ */

export function senToRM(sen) {
  return (sen ?? 0) / 100;
}

export function formatRMFromSen(sen) {
  return `RM ${senToRM(sen).toLocaleString("en-MY", {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  })}`;
}

/** Ringgit formatter for UI-ready numbers (used by mapped transactions). */
export function formatRM(value) {
  return `RM ${value.toLocaleString("en-MY", {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  })}`;
}

/* ------------------------------------------------------------------ */
/* Date ranges                                                         */
/* ------------------------------------------------------------------ */

function todayRange() {
  const now = new Date();
  const start = new Date(now.getFullYear(), now.getMonth(), now.getDate());
  const end = new Date(start);
  end.setDate(end.getDate() + 1);
  return { start: Timestamp.fromDate(start), end: Timestamp.fromDate(end) };
}

/** [start, end) Timestamps covering one "yyyy-MM" month key. */
function monthRange(monthKey) {
  const [year, month] = monthKey.split("-").map(Number);
  return {
    start: Timestamp.fromDate(new Date(year, month - 1, 1)),
    end: Timestamp.fromDate(new Date(year, month, 1)),
  };
}

export function monthKeysFromDate(firstDate) {
  const now = new Date();
  const start = firstDate ? new Date(firstDate) : now;

  const keys = [];

  for (
    let d = new Date(start.getFullYear(), start.getMonth(), 1);
    d <= new Date(now.getFullYear(), now.getMonth(), 1);
    d.setMonth(d.getMonth() + 1)
  ) {
    keys.push(
      `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}`,
    );
  }

  return keys;
}

/** The last `count` "yyyy-MM" keys, oldest first (for the month bar). */
export function recentMonthKeys(count = 12) {
  const keys = [];
  const now = new Date();
  for (let i = count - 1; i >= 0; i--) {
    const d = new Date(now.getFullYear(), now.getMonth() - i, 1);
    keys.push(
      `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}`,
    );
  }
  return keys;
}

export async function getEarliestTransactionDate(orgId) {
  const transactionsRef = collection(
    db,
    "organizations",
    orgId,
    "transactions",
  );

  const q = query(transactionsRef, orderBy("date", "asc"), limit(1));

  const snapshot = await getDocs(q);

  if (snapshot.empty) {
    return null;
  }

  const data = snapshot.docs[0].data();

  return data.date?.toDate ? data.date.toDate() : new Date(data.date);
}

/* ------------------------------------------------------------------ */
/* Mapping: Firestore doc -> the shape the UI already uses             */
/* ------------------------------------------------------------------ */

export function mapTransaction(id, data) {
  const date = data.date?.toDate ? data.date.toDate() : new Date(data.date);
  return {
    id,
    title: data.description ?? "-",
    category: data.category ?? "other",
    // schema: "in" | "out"  ->  UI: "earning" | "spending"
    type: data.type === "in" ? "earning" : "spending",
    amount: senToRM(data.amount),
    date: date.toISOString(),
    method: data.paymentMethod ?? "-",
    reference: id,
    note: data.note ?? "",
  };
}

function isVisible(data) {
  return !data.deletedAt && data.status !== "pending_review";
}

/* ------------------------------------------------------------------ */
/* Queries                                                             */
/* ------------------------------------------------------------------ */

/** Live daily totals for the home page. */
export function subscribeDailyStats(orgId, callback) {
  const { start, end } = todayRange();
  const q = query(
    collection(db, "organizations", orgId, "transactions"),
    where("date", ">=", start),
    where("date", "<", end),
  );

  return onSnapshot(
    q,
    (snap) => {
      let sales = 0;
      let spending = 0;
      snap.forEach((doc) => {
        const d = doc.data();
        if (!isVisible(d)) return;
        if (d.type === "in") sales += d.amount ?? 0;
        else if (d.type === "out") spending += d.amount ?? 0;
      });
      callback({ sales, spending, profit: sales - spending, loaded: true });
    },
    (err) => console.error("Daily stats listener failed:", err),
  );
}

/** All confirmed transactions of one month, newest first. */
export function subscribeMonthTransactions(orgId, monthKey, callback) {
  const { start, end } = monthRange(monthKey);
  const q = query(
    collection(db, "organizations", orgId, "transactions"),
    where("date", ">=", start),
    where("date", "<", end),
  );

  return onSnapshot(
    q,
    (snap) => {
      const items = [];
      snap.forEach((doc) => {
        const data = doc.data();
        if (!isVisible(data)) return;
        items.push(mapTransaction(doc.id, data));
      });
      items.sort((a, b) => new Date(b.date) - new Date(a.date));
      callback(items);
    },
    (err) => console.error("Transaction listener failed:", err),
  );
}

/** One-time read of a single transaction (detail page). */
export async function getTransaction(orgId, txId) {
  const snap = await getDoc(
    doc(db, "organizations", orgId, "transactions", txId),
  );
  if (!snap.exists()) return null;
  const data = snap.data();
  if (!isVisible(data)) return null;
  return mapTransaction(snap.id, data);
}

/** Add one confirmed transaction. Amount arrives in RM and is stored as sen. */
export async function addTransaction({ orgId, user, transaction }) {
  const { type, amount, category, description, date, paymentMethod, note } =
    transaction;

  await addDoc(collection(db, "organizations", orgId, "transactions"), {
    type, // "in" | "out"
    amount: Math.round(amount * 100), // integer sen, matches the schema
    category,
    description: description.trim(),
    // date input gives "YYYY-MM-DD"; keep it at local midnight
    date: Timestamp.fromDate(new Date(`${date}T00:00:00`)),
    paymentMethod,
    note: note?.trim() ?? "",
    status: "confirmed",
    createdBy: user.uid,
    createdAt: serverTimestamp(),
    updatedAt: serverTimestamp(),
  });
}

/* ------------------------------------------------------------------ */
/* Display helpers (moved from data/transactions.js)                   */
/* ------------------------------------------------------------------ */

export const categoryColors = {
  Salary: "#2563eb",
  Freelance: "#7c3aed",
  Investment: "#0891b2",
  Bonus: "#f59e0b",
  Food: "#e11d48",
  Transport: "#312e81",
  Utilities: "#0d9488",
  Entertainment: "#ea580c",
  Shopping: "#7d909b",
  // cash-flow schema categories
  sales: "#059669",
  stock_purchase: "#e11d48",
  rent: "#312e81",
  utilities: "#0d9488",
  salary: "#2563eb",
  marketing: "#ea580c",
  platform_fee: "#7d909b",
  tax: "#f59e0b",
  other: "#7d909b",
};

export function getCategoryColor(category) {
  return categoryColors[category] || "#7d909b";
}

export function formatAmount(item) {
  const sign = item.type === "earning" ? "+" : "-";
  return `${sign} ${formatRM(item.amount)}`;
}

export function formatDate(value) {
  return new Date(value).toLocaleString("en-MY", {
    day: "numeric",
    month: "short",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  });
}
</file>

<file path="lib/usage.js">
import { promises as fs } from "fs";
import path from "path";

// Saved next to the project. Add .usage-data.json to .gitignore.
const FILE = path.join(process.cwd(), ".usage-data.json");
const WARN_AT = Number(process.env.CREDIT_WARN_PERCENT) || 80;
const CRITICAL_AT = Number(process.env.CREDIT_CRITICAL_PERCENT) || 95;

let queue = Promise.resolve(); // makes saves happen one at a time
const dayKey = () => new Date().toISOString().slice(0, 10);
const round2 = (n) => Math.round(n * 100) / 100;

async function readData() {
  try {
    const d = JSON.parse(await fs.readFile(FILE, "utf8"));
    return { days: d?.days || {}, depletedAt: d?.depletedAt || null };
  } catch {
    return { days: {}, depletedAt: null };
  }
}

async function writeData(data) {
  try {
    await fs.writeFile(FILE, JSON.stringify(data));
  } catch (e) {
    console.error("[usage] could not save:", e?.message);
  }
}

function update(fn) {
  queue = queue
    .then(async () => {
      const data = await readData();
      fn(data);
      await writeData(data);
    })
    .catch((e) => console.error("[usage]", e?.message));
  return queue;
}

// Call after every successful Gemini request, with response.usageMetadata.
export function recordUsage(meta) {
  const input = Number(meta?.promptTokenCount) || 0;
  const output = (Number(meta?.candidatesTokenCount) || 0) + (Number(meta?.thoughtsTokenCount) || 0);
  if (!input && !output) return Promise.resolve();
  return update((data) => {
    const k = dayKey();
    const day = data.days[k] || { input: 0, output: 0 };
    day.input += input;
    day.output += output;
    data.days[k] = day;
    data.depletedAt = null; // a successful call means credit works
  });
}

// Call when Gemini says the credit has run out.
export function markDepleted() {
  return update((data) => {
    data.depletedAt = new Date().toISOString();
  });
}

export async function creditStatus() {
  const data = await readData();
  const start = process.env.GEMINI_CREDIT_START || "1970-01-01";

  let input = 0;
  let output = 0;
  for (const [k, v] of Object.entries(data.days)) {
    if (k >= start) {
      input += v.input || 0;
      output += v.output || 0;
    }
  }

  const tokenBudget = Number(process.env.GEMINI_TOKEN_BUDGET) || 0;
  const usdBudget = Number(process.env.GEMINI_BUDGET_USD) || 0;
  const priceIn = Number(process.env.GEMINI_PRICE_INPUT_PER_M) || 0;
  const priceOut = Number(process.env.GEMINI_PRICE_OUTPUT_PER_M) || 0;

  let unit = null;
  let used = 0;
  let budget = 0;
  if (tokenBudget > 0) {
    unit = "tokens";
    used = input + output;
    budget = tokenBudget;
  } else if (usdBudget > 0 && (priceIn > 0 || priceOut > 0)) {
    unit = "USD";
    used = (input * priceIn + output * priceOut) / 1e6;
    budget = usdBudget;
  }

  const percentUsed = budget > 0 ? Math.min(100, Math.round((used / budget) * 100)) : null;
  const percentLeft = percentUsed == null ? null : 100 - percentUsed;
  const depleted = Boolean(data.depletedAt) || percentUsed === 100;

  let level = "unknown"; // no budget set
  if (depleted) level = "depleted";
  else if (percentUsed != null) level = percentUsed >= CRITICAL_AT ? "critical" : percentUsed >= WARN_AT ? "low" : "ok";

  const message =
    level === "depleted"
      ? "The AI credit may have run out. Please ask the key owner to top up."
      : level === "critical"
        ? `AI credit is almost gone (about ${percentLeft}% left). Please top up now.`
        : level === "low"
          ? `AI credit is running low (about ${percentLeft}% left). Please plan a top-up soon.`
          : null;

  return {
    level,
    message,
    percentUsed,
    percentLeft,
    unit,
    used: round2(used),
    budget,
    input,
    output,
    since: start === "1970-01-01" ? null : start,
  };
}

// The small version that is safe to show to every visitor of the site.
export const publicCredit = (c) => ({ level: c.level, percentLeft: c.percentLeft, message: c.message });
</file>

