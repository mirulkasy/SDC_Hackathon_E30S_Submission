"use client";

import { useEffect, useMemo, useState } from "react";
import { doc, getDoc } from "firebase/firestore";
import { db } from "@/lib/firebase";
import { useAuth } from "@/context/AuthContext";
import { addTransaction } from "@/lib/transactions";
import AppBar from "@/components/layout/AppBar";
import NavBar from "@/components/layout/NavBar";
import CustomInput from "@/components/input/CustomInput";
import styles from "./invoice.module.css";

const money = (n) =>
  `RM ${Number(n || 0).toLocaleString("en-MY", {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  })}`;
const todayISO = () => new Date().toLocaleDateString("en-CA");

function makeInvoiceNo() {
  const d = new Date();
  const stamp = `${d.getFullYear()}${String(d.getMonth() + 1).padStart(2, "0")}${String(d.getDate()).padStart(2, "0")}`;
  const rand = Math.random().toString(36).slice(2, 6).toUpperCase();
  return `INV-${stamp}-${rand}`;
}

function newItem() {
  return {
    id: `item-${Date.now()}-${Math.random().toString(36).slice(2, 7)}`,
    description: "",
    qty: 1,
    price: "",
  };
}

export default function InvoicePage() {
  const { user, profile } = useAuth();
  const orgId = profile?.orgId;

  const [mode, setMode] = useState("edit"); // "edit" | "preview"
  const [saving, setSaving] = useState(false);
  const [savedNote, setSavedNote] = useState("");

  const [invoiceNo, setInvoiceNo] = useState("");
  const [invoiceDate, setInvoiceDate] = useState(todayISO());
  const [dueDate, setDueDate] = useState("");

  const [from, setFrom] = useState({
    name: "",
    phone: "",
    email: "",
    address: "",
  });
  const [to, setTo] = useState({ name: "", phone: "", email: "", address: "" });

  const [items, setItems] = useState([newItem()]);
  const [taxRate, setTaxRate] = useState("0");
  const [notes, setNotes] = useState("");

  // One invoice number per visit; the owner can still override it.
  useEffect(() => {
    setInvoiceNo(makeInvoiceNo());
  }, []);

  // Prefill "From" with the organization's name, once.
  useEffect(() => {
    if (!orgId) return;
    getDoc(doc(db, "organizations", orgId))
      .then((snap) => {
        if (!snap.exists()) return;
        const data = snap.data();
        setFrom((f) => ({ ...f, name: f.name || data.name || "" }));
      })
      .catch((err) => console.error("Organization read failed:", err));
  }, [orgId]);

  useEffect(() => {
    if (profile?.email) {
      setFrom((f) => ({ ...f, email: f.email || profile.email }));
    }
  }, [profile?.email]);

  function updateItem(id, patch) {
    setItems((prev) =>
      prev.map((it) => (it.id === id ? { ...it, ...patch } : it)),
    );
  }
  function addItem() {
    setItems((prev) => [...prev, newItem()]);
  }
  function removeItem(id) {
    setItems((prev) =>
      prev.length > 1 ? prev.filter((it) => it.id !== id) : prev,
    );
  }

  const lineTotals = useMemo(
    () => items.map((it) => (Number(it.qty) || 0) * (Number(it.price) || 0)),
    [items],
  );
  const subtotal = useMemo(
    () => lineTotals.reduce((s, v) => s + v, 0),
    [lineTotals],
  );
  const taxAmount = useMemo(
    () => (subtotal * (Number(taxRate) || 0)) / 100,
    [subtotal, taxRate],
  );
  const total = subtotal + taxAmount;

  const canPreview = items.some(
    (it) => it.description.trim() && Number(it.price) > 0,
  );

  function handlePrint() {
    window.print();
  }

  async function handleRecordSale() {
    if (!orgId || !user || total <= 0 || saving) return;
    setSaving(true);
    setSavedNote("");
    try {
      await addTransaction({
        orgId,
        user,
        transaction: {
          type: "in",
          amount: Number(total.toFixed(2)),
          category: "sales",
          description: `Invoice ${invoiceNo}${to.name ? ` — ${to.name}` : ""}`,
          date: invoiceDate,
          paymentMethod: "Bank Transfer",
          note: "Recorded from the E-Invoice page.",
        },
      });
      setSavedNote("Recorded as a sale in your transactions.");
    } catch (err) {
      console.error("Record sale failed:", err);
      setSavedNote("Could not record the sale. Please try again.");
    } finally {
      setSaving(false);
    }
  }

  return (
    <>
      <AppBar title="E-Invoice" />
      <main className={styles.invoicePage}>
        {mode === "edit" ? (
          <section className={styles.formSection}>
            <h2>From</h2>
            <div className={styles.formCard}>
              <CustomInput
                label="Business Name"
                value={from.name}
                onChange={(e) =>
                  setFrom((f) => ({ ...f, name: e.target.value }))
                }
              />
              <div className={styles.fieldGrid}>
                <CustomInput
                  label="Phone"
                  value={from.phone}
                  onChange={(e) =>
                    setFrom((f) => ({ ...f, phone: e.target.value }))
                  }
                />
                <CustomInput
                  label="Email"
                  type="email"
                  value={from.email}
                  onChange={(e) =>
                    setFrom((f) => ({ ...f, email: e.target.value }))
                  }
                />
              </div>
              <CustomInput
                label="Address"
                longInput
                value={from.address}
                onChange={(e) =>
                  setFrom((f) => ({ ...f, address: e.target.value }))
                }
              />
            </div>

            <h2>Bill To</h2>
            <div className={styles.formCard}>
              <CustomInput
                label="Customer Name"
                value={to.name}
                onChange={(e) => setTo((t) => ({ ...t, name: e.target.value }))}
              />
              <div className={styles.fieldGrid}>
                <CustomInput
                  label="Phone"
                  value={to.phone}
                  onChange={(e) =>
                    setTo((t) => ({ ...t, phone: e.target.value }))
                  }
                />
                <CustomInput
                  label="Email"
                  type="email"
                  value={to.email}
                  onChange={(e) =>
                    setTo((t) => ({ ...t, email: e.target.value }))
                  }
                />
              </div>
              <CustomInput
                label="Address"
                longInput
                value={to.address}
                onChange={(e) =>
                  setTo((t) => ({ ...t, address: e.target.value }))
                }
              />
            </div>

            <h2>Invoice Details</h2>
            <div className={styles.formCard}>
              <div className={styles.fieldGrid}>
                <CustomInput
                  label="Invoice No"
                  value={invoiceNo}
                  onChange={(e) => setInvoiceNo(e.target.value)}
                />
                <CustomInput
                  label="Date"
                  type="date"
                  value={invoiceDate}
                  onChange={(e) => setInvoiceDate(e.target.value)}
                />
              </div>
              <CustomInput
                label="Due Date (optional)"
                type="date"
                value={dueDate}
                onChange={(e) => setDueDate(e.target.value)}
              />
            </div>

            <h2>Items</h2>
            <div className={styles.itemsCard}>
              {items.map((it, i) => (
                <div key={it.id} className={styles.itemRow}>
                  <input
                    className={styles.itemDesc}
                    placeholder="Item description"
                    value={it.description}
                    onChange={(e) =>
                      updateItem(it.id, { description: e.target.value })
                    }
                  />
                  <input
                    className={styles.itemQty}
                    type="number"
                    min="0"
                    step="1"
                    placeholder="Qty"
                    value={it.qty}
                    onChange={(e) => updateItem(it.id, { qty: e.target.value })}
                  />
                  <input
                    className={styles.itemPrice}
                    type="number"
                    min="0"
                    step="0.01"
                    placeholder="Price"
                    value={it.price}
                    onChange={(e) =>
                      updateItem(it.id, { price: e.target.value })
                    }
                  />
                  <span className={styles.itemTotal}>
                    {money(lineTotals[i])}
                  </span>
                  <button
                    type="button"
                    className={styles.removeItemBtn}
                    onClick={() => removeItem(it.id)}
                    aria-label="Remove item"
                    disabled={items.length <= 1}
                  >
                    ×
                  </button>
                </div>
              ))}
              <button
                type="button"
                className={styles.addItemBtn}
                onClick={addItem}
              >
                + Add item
              </button>
            </div>

            <div className={styles.totalsCard}>
              <div className={styles.totalRow}>
                <span>Subtotal</span>
                <span>{money(subtotal)}</span>
              </div>
              <div className={styles.totalRow}>
                <span>
                  Tax / SST (%)
                  <input
                    className={styles.taxInput}
                    type="number"
                    min="0"
                    step="0.1"
                    value={taxRate}
                    onChange={(e) => setTaxRate(e.target.value)}
                  />
                </span>
                <span>{money(taxAmount)}</span>
              </div>
              <div className={`${styles.totalRow} ${styles.grandTotal}`}>
                <span>Total</span>
                <span>{money(total)}</span>
              </div>
            </div>

            <CustomInput
              label="Notes (optional)"
              longInput
              value={notes}
              onChange={(e) => setNotes(e.target.value)}
              placeholder="Payment instructions, thank-you note, etc."
            />

            <button
              type="button"
              className={styles.previewBtn}
              disabled={!canPreview}
              onClick={() => setMode("preview")}
            >
              Preview Invoice
            </button>
            {!canPreview && (
              <p className={styles.hint}>
                Add at least one item with a description and price to preview.
              </p>
            )}
          </section>
        ) : (
          <section className={styles.previewSection}>
            <div className={styles.previewActions}>
              <button
                type="button"
                className={styles.backBtn}
                onClick={() => setMode("edit")}
              >
                ← Edit
              </button>
              <div className={styles.previewActionsRight}>
                <button
                  type="button"
                  className={styles.recordBtn}
                  onClick={handleRecordSale}
                  disabled={saving}
                >
                  {saving ? "Saving..." : "Record as Sale"}
                </button>
                <button
                  type="button"
                  className={styles.printBtn}
                  onClick={handlePrint}
                >
                  Print / Save PDF
                </button>
              </div>
            </div>
            {savedNote && <p className={styles.savedNote}>{savedNote}</p>}

            <div id="invoice-print" className={styles.invoiceSheet}>
              <div className={styles.sheetHeader}>
                <div>
                  <h1>{from.name || "Your Business"}</h1>
                  {from.address && <p>{from.address}</p>}
                  {(from.phone || from.email) && (
                    <p>
                      {[from.phone, from.email].filter(Boolean).join(" · ")}
                    </p>
                  )}
                </div>
                <div className={styles.sheetMeta}>
                  <h2>INVOICE</h2>
                  <p>{invoiceNo}</p>
                  <p>Date: {invoiceDate}</p>
                  {dueDate && <p>Due: {dueDate}</p>}
                </div>
              </div>

              <div className={styles.sheetBillTo}>
                <p className={styles.sheetLabel}>Bill To</p>
                <p className={styles.sheetBillName}>{to.name || "-"}</p>
                {to.address && <p>{to.address}</p>}
                {(to.phone || to.email) && (
                  <p>{[to.phone, to.email].filter(Boolean).join(" · ")}</p>
                )}
              </div>

              <table className={styles.sheetTable}>
                <thead>
                  <tr>
                    <th>Description</th>
                    <th>Qty</th>
                    <th>Price</th>
                    <th>Amount</th>
                  </tr>
                </thead>
                <tbody>
                  {items.map((it, i) => (
                    <tr key={it.id}>
                      <td>{it.description || "-"}</td>
                      <td>{it.qty || 0}</td>
                      <td>{money(it.price)}</td>
                      <td>{money(lineTotals[i])}</td>
                    </tr>
                  ))}
                </tbody>
              </table>

              <div className={styles.sheetTotals}>
                <div className={styles.sheetTotalRow}>
                  <span>Subtotal</span>
                  <span>{money(subtotal)}</span>
                </div>
                {Number(taxRate) > 0 && (
                  <div className={styles.sheetTotalRow}>
                    <span>Tax / SST ({taxRate}%)</span>
                    <span>{money(taxAmount)}</span>
                  </div>
                )}
                <div
                  className={`${styles.sheetTotalRow} ${styles.sheetGrandTotal}`}
                >
                  <span>Total</span>
                  <span>{money(total)}</span>
                </div>
              </div>

              {notes && (
                <div className={styles.sheetNotes}>
                  <p className={styles.sheetLabel}>Notes</p>
                  <p>{notes}</p>
                </div>
              )}
            </div>
          </section>
        )}
      </main>
    </>
  );
}
</file>

<file path="app/(protected)/profile/page.js">
"use client";

import { useEffect, useState } from "react";
import { signOut } from "firebase/auth";
import { collection, doc, onSnapshot } from "firebase/firestore";

import { auth, db } from "@/lib/firebase";
import { useAuth } from "@/context/AuthContext";
import { BUSINESS_TYPES } from "@/lib/businessTypes";
import { updateOrganization, updateUserName } from "@/lib/profile";
import NavBar from "@/components/layout/NavBar";
import AppBar from "@/components/layout/AppBar";
import styles from "./profile.module.css";

export default function ProfilePage() {
  const { user, profile } = useAuth();

  const [activeTab, setActiveTab] = useState("profile");
  const [org, setOrg] = useState(null);
  const [members, setMembers] = useState([]);
  const [copied, setCopied] = useState(false);

  const [nameDraft, setNameDraft] = useState(null);
  const [orgDraft, setOrgDraft] = useState(null);

  const [savingName, setSavingName] = useState(false);
  const [savingOrg, setSavingOrg] = useState(false);

  const [nameError, setNameError] = useState("");
  const [orgError, setOrgError] = useState("");

  const orgId = profile?.orgId;
  const isOwner = profile?.role === "owner";

  // Listen to organization details.
  useEffect(() => {
    if (!orgId) {
      setOrg(null);
      return;
    }

    return onSnapshot(
      doc(db, "organizations", orgId),
      (snap) => setOrg(snap.exists() ? snap.data() : null),
      (err) => console.error("Organization listener failed:", err),
    );
  }, [orgId]);

  // Listen to every member in the organization.
  useEffect(() => {
    if (!orgId) {
      setMembers([]);
      return;
    }

    return onSnapshot(
      collection(db, "organizations", orgId, "members"),
      (snap) => {
        const list = snap.docs.map((memberDoc) => ({
          id: memberDoc.id,
          ...memberDoc.data(),
        }));

        // Show the owner first, then sort other members by name.
        list.sort((a, b) => {
          if (a.role === "owner") return -1;
          if (b.role === "owner") return 1;

          return (a.name || a.email || "").localeCompare(
            b.name || b.email || "",
          );
        });

        setMembers(list);
      },
      (err) => console.error("Members listener failed:", err),
    );
  }, [orgId]);

  useEffect(() => {
    if (!copied) return;

    const timer = setTimeout(() => setCopied(false), 2000);
    return () => clearTimeout(timer);
  }, [copied]);

  const nameValue = nameDraft ?? profile?.name ?? "";
  const nameDirty =
    nameDraft !== null && nameDraft.trim() !== (profile?.name ?? "");

  const orgNameValue = orgDraft?.name ?? org?.name ?? "";
  const businessTypeValue = orgDraft?.businessType ?? org?.businessType ?? "";

  const orgDirty =
    orgDraft !== null &&
    (orgNameValue.trim() !== (org?.name ?? "") ||
      businessTypeValue !== (org?.businessType ?? ""));

  const typeLabel =
    BUSINESS_TYPES.find((type) => type.id === org?.businessType)?.label ?? "-";

  const editOrg = (patch) => {
    if (!isOwner) return;

    setOrgDraft((draft) => ({
      name: orgNameValue,
      businessType: businessTypeValue,
      ...draft,
      ...patch,
    }));
  };

  const handleCopy = async () => {
    if (!org?.inviteCode) return;

    try {
      await navigator.clipboard.writeText(org.inviteCode);
      setCopied(true);
    } catch (err) {
      console.error("Copy failed:", err);
    }
  };

  const handleSaveName = async (e) => {
    e.preventDefault();

    if (!nameValue.trim()) {
      setNameError("Name is required.");
      return;
    }

    setNameError("");
    setSavingName(true);

    try {
      await updateUserName({
        user,
        orgId,
        name: nameValue.trim(),
      });

      setNameDraft(null);
    } catch (err) {
      console.error(err);
      setNameError("Could not save your name. Please try again.");
    } finally {
      setSavingName(false);
    }
  };

  const handleSaveOrg = async (e) => {
    e.preventDefault();

    // Do not allow non-owners to save organization details.
    if (!isOwner) return;

    if (!orgNameValue.trim()) {
      setOrgError("Organization name is required.");
      return;
    }

    if (!businessTypeValue) {
      setOrgError("Pick a business type.");
      return;
    }

    setOrgError("");
    setSavingOrg(true);

    try {
      await updateOrganization({
        orgId,
        name: orgNameValue.trim(),
        businessType: businessTypeValue,
      });

      setOrgDraft(null);
    } catch (err) {
      console.error(err);
      setOrgError("Could not save the organization. Please try again.");
    } finally {
      setSavingOrg(false);
    }
  };

  return (
    <>
      <AppBar title="Profile" />

      <main className={styles.profilePage}>
        {/* Tabs */}
        <div className={styles.tabs} role="tablist" aria-label="Settings">
          <button
            type="button"
            role="tab"
            aria-selected={activeTab === "profile"}
            className={`${styles.tab} ${
              activeTab === "profile" ? styles.activeTab : ""
            }`}
            onClick={() => setActiveTab("profile")}
          >
            Profile
          </button>

          <button
            type="button"
            role="tab"
            aria-selected={activeTab === "organization"}
            className={`${styles.tab} ${
              activeTab === "organization" ? styles.activeTab : ""
            }`}
            onClick={() => setActiveTab("organization")}
          >
            Organization
          </button>
        </div>

        {/* PROFILE TAB */}
        {activeTab === "profile" && (
          <>
            <form className={styles.section} onSubmit={handleSaveName}>
              <h2 className={styles.sectionTitle}>Account</h2>

              <div className={styles.card}>
                <label className={styles.field}>
                  <span className={styles.fieldLabel}>Name</span>

                  <input
                    className={styles.fieldInput}
                    name="name"
                    autoComplete="name"
                    value={nameValue}
                    onChange={(e) => setNameDraft(e.target.value)}
                  />
                </label>

                <div className={styles.field}>
                  <span className={styles.fieldLabel}>Email</span>
                  <p className={`${styles.fieldText} ${styles.emailText}`}>
                    {profile?.email ?? user?.email ?? "-"}
                  </p>
                </div>
              </div>

              <p
                className={styles.errorText}
                role={nameError ? "alert" : undefined}
              >
                {nameError}
              </p>

              {nameDirty && (
                <button
                  type="submit"
                  className={styles.saveBtn}
                  disabled={savingName}
                >
                  {savingName ? "Saving..." : "Save"}
                </button>
              )}
            </form>

            <section className={styles.section}>
              <button
                type="button"
                className={styles.logoutBtn}
                onClick={() => signOut(auth)}
              >
                <svg
                  className={styles.logoutLogo}
                  xmlns="http://www.w3.org/2000/svg"
                  fill="none"
                  viewBox="0 0 24 24"
                  strokeWidth="1.5"
                  stroke="currentColor"
                >
                  <path
                    strokeLinecap="round"
                    strokeLinejoin="round"
                    d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9"
                  />
                </svg>
                Log Out
              </button>
            </section>
          </>
        )}

        {/* ORGANIZATION TAB */}
        {activeTab === "organization" && (
          <>
            {!orgId ? (
              <section className={styles.section}>
                <div className={styles.card}>
                  <p className={styles.emptyText}>
                    You are not part of an organization yet.
                  </p>
                </div>
              </section>
            ) : (
              <>
                {/* Organization code banner moved here */}
                <section className={styles.codeWrapper}>
                  <div className={styles.codeBanner}>
                    <div className={styles.codeInfo}>
                      <h1>Organization Code</h1>
                      <p>
                        Share this code with people you want to invite to your
                        organization.
                      </p>
                      <h2>{org?.inviteCode ?? "--------"}</h2>
                    </div>

                    <button
                      type="button"
                      className={styles.copyBtn}
                      onClick={handleCopy}
                      disabled={!org?.inviteCode}
                    >
                      {copied ? "Copied" : "Copy"}
                    </button>
                  </div>
                </section>

                {/* Organization details */}
                <form className={styles.section} onSubmit={handleSaveOrg}>
                  <h2 className={styles.sectionTitle}>Organization Details</h2>

                  <div className={styles.card}>
                    {isOwner ? (
                      <>
                        <label className={styles.field}>
                          <span className={styles.fieldLabel}>
                            Organization Name
                          </span>

                          <input
                            className={styles.fieldInput}
                            name="orgName"
                            autoComplete="organization"
                            value={orgNameValue}
                            onChange={(e) => editOrg({ name: e.target.value })}
                          />
                        </label>

                        <div className={styles.field}>
                          <span className={styles.fieldLabel}>
                            Business Type
                          </span>

                          <div className={styles.typeWrapper}>
                            {BUSINESS_TYPES.map((type) => (
                              <button
                                key={type.id}
                                type="button"
                                aria-pressed={businessTypeValue === type.id}
                                className={`${styles.typeBtn} ${
                                  businessTypeValue === type.id
                                    ? styles.typeBtnActive
                                    : ""
                                }`}
                                onClick={() =>
                                  editOrg({ businessType: type.id })
                                }
                              >
                                {type.label}
                              </button>
                            ))}
                          </div>
                        </div>
                      </>
                    ) : (
                      <>
                        <div className={styles.field}>
                          <span className={styles.fieldLabel}>
                            Organization Name
                          </span>
                          <p className={styles.fieldText}>{org?.name ?? "-"}</p>
                        </div>

                        <div className={styles.field}>
                          <span className={styles.fieldLabel}>
                            Business Type
                          </span>
                          <p className={styles.fieldText}>{typeLabel}</p>
                        </div>
                      </>
                    )}
                  </div>

                  <p
                    className={styles.errorText}
                    role={orgError ? "alert" : undefined}
                  >
                    {orgError}
                  </p>

                  {isOwner && orgDirty && (
                    <button
                      type="submit"
                      className={styles.saveBtn}
                      disabled={savingOrg}
                    >
                      {savingOrg ? "Saving..." : "Save"}
                    </button>
                  )}
                </form>

                {/* All organization members */}
                <section className={styles.section}>
                  <div className={styles.memberHeading}>
                    <h2 className={styles.sectionTitle}>Members</h2>
                    <span className={styles.memberCount}>{members.length}</span>
                  </div>

                  <div className={styles.card}>
                    {members.length === 0 ? (
                      <p className={styles.emptyText}>
                        Loading members or no members found.
                      </p>
                    ) : (
                      members.map((member) => (
                        <div key={member.id} className={styles.memberRow}>
                          <div className={styles.memberAvatar}>
                            {(member.name || member.email || "?")
                              .trim()
                              .charAt(0)
                              .toUpperCase()}
                          </div>

                          <div className={styles.memberInfo}>
                            <p className={styles.memberName}>
                              {member.name || "Unnamed member"}
                              {member.id === user?.uid && (
                                <span className={styles.youLabel}>You</span>
                              )}
                            </p>

                            <p className={styles.memberEmail}>
                              {member.email || "No email"}
                            </p>
                          </div>

                          <span
                            className={`${styles.roleBadge} ${
                              member.role === "owner" ? styles.ownerBadge : ""
                            }`}
                          >
                            {member.role === "owner" ? "Owner" : "Staff"}
                          </span>
                        </div>
                      ))
                    )}
                  </div>

                  <p className={styles.hint}>
                    Only the organization owner can edit organization details.
                  </p>
                </section>
              </>
            )}
          </>
        )}
      </main>

      <NavBar />
    </>
  );
}
</file>

<file path="app/(protected)/profile/profile.module.css">
.profilePage {
    padding: 10px 0 150px !important;
    background-color: #f5f7f6;
    min-height: 100svh;
}

/* ── Section 1: Organization code banner ── */
.codeWrapper {
    padding: 10px 15px;
    box-sizing: border-box;
}

.codeBanner {
    position: relative;
    box-sizing: border-box;
    padding: 20px 15px;
    border-radius: 12px;
    background-color: #134f3d;
    width: 100%;

    display: flex;
    flex-direction: column;
    gap: 10px;
    overflow: hidden;
}

.codeInfo {
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.codeInfo h1 {
    font-size: var(--fontsize-16);
    font-weight: 600;
    color: white;
}

.codeInfo p {
    padding: 5px 0;
    width: 80%;
    font-size: var(--fontsize-14);
    font-style: italic;
    font-weight: 500;
    color: #ccc;
}

.codeInfo h2 {
    margin-top: 10px;
    padding: 10px 8px;
    border-radius: 5px;
    background-color: rgba(0,0,0,0.3);
    border-left: 4px solid white;
    font-size: var(--fontsize-20);
    font-weight: 500;
    letter-spacing: 0.15em;
    color: white;
}

.copyBtn {
    margin-top: 5px;
    width: fit-content;
    background-color: white;
    border-radius: 999px;
    padding: 8px 16px;
    font-weight: 600;
    font-size: var(--fontsize-13);
}

.copyBtn:disabled {
    opacity: 0.5;
    cursor: default;
}

/* ── Sections 3-5: Cards ── */
.section {
    box-sizing: border-box;
    width: 100%;
    padding: 15px 15px 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.sectionTitle {
    margin: 0 0 0 5px;
    font-size: var(--fontsize-14);
    font-weight: 600;
    color: var(--primary);
}

.card {
    box-sizing: border-box;
    width: 100%;
    background-color: white;
    border-radius: 12px;
    overflow: hidden;
}

/* Telegram-style row: small label on top, value below, divider between rows */
.field {
    position: relative;
    box-sizing: border-box;
    padding: 12px 45px 12px 15px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    border-bottom: 1px solid #f0f0f0;
}

.field:last-child {
    border-bottom: none;
}

.fieldLabel {
    font-size: var(--fontsize-13);
    font-weight: 700;
    color: var(--primary);
}

/* Borderless input that reads like plain text until tapped */
.fieldInput {
    box-sizing: border-box;
    width: 100%;
    height: auto;
    padding: 0;
    background-color: transparent;
    border: none;
    border-radius: 0;
    font-family: inherit;
    font-size: var(--fontsize-16);
    font-weight: 500;
    color: var(--dark);
    cursor: text;
    user-select: text;
}

.fieldText {
    font-size: var(--fontsize-16);
    font-weight: 500;
    color: var(--dark);
    word-break: break-all;
}

.emailText {
    color: #ccc;
}

.typeWrapper {
    padding: 6px 0 2px;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 8px;
}

.typeBtn {
    flex: 1 1 auto;
    padding: 8px 10px;
    background-color: white;
    border: 2px solid var(--primary);
    color: var(--primary);
    font-size: var(--fontsize-13);
    font-weight: 600;
    border-radius: 999px;
    text-align: center;
}

.typeBtnActive {
    background-color: var(--primary);
    color: white;
}

.hint {
    margin: 0 0 0 5px;
    font-size: var(--fontsize-12);
    color: #888;
}

.errorText {
    margin: 0 0 0 5px;
    font-size: var(--fontsize-12);
    font-weight: 500;
    color: #ff3b30;
}

.errorText:empty {
    display: none;
}

.saveBtn {
    align-self: flex-end;
    background-color: var(--primary);
    color: white;
    border-radius: 999px;
    padding: 10px 24px;
    font-size: var(--fontsize-14);
    font-weight: 600;
}

.saveBtn:disabled {
    opacity: 0.6;
    cursor: default;
}

.logoutBtn {
    margin-top: 30px;
    border-radius: 12px;
    border: 2px solid #ff3b30;
    box-sizing: border-box;
    width: 100%;
    padding: 10px 15px;
    font-size: var(--fontsize-14);
    font-weight: 500;
    color: #ff3b30;

    display: flex;
    gap: 10px;
    align-items: center;
    justify-content: center;
}

.logoutLogo {
    width: 22px;
}


/* Profile and Organization tabs */
.tabs {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 5px;
    margin: 10px 15px 5px;
    padding: 5px;
    background: #e8ecea;
    border-radius: 12px;
}

.tab {
    text-align: center;
    padding: 11px 8px;
    border-radius: 9px;
    background: transparent;
    color: #666;
    font-size: var(--fontsize-14);
    font-weight: 600;
    transition: background-color 0.2s, color 0.2s;
}

.activeTab {
    background: white;
    color: var(--primary);
    box-shadow: 0 1px 4px rgba(0, 0, 0, 0.08);
}

/* Members list */
.memberHeading {
    display: flex;
    align-items: center;
    gap: 8px;
}

.memberCount {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 23px;
    height: 23px;
    padding: 0 6px;
    box-sizing: border-box;
    border-radius: 999px;
    background: #e8ecea;
    color: var(--primary);
    font-size: var(--fontsize-12);
    font-weight: 700;
}

.memberRow {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 14px 15px;
    border-bottom: 1px solid #f0f0f0;
}

.memberRow:last-child {
    border-bottom: none;
}

.memberAvatar {
    display: flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    width: 42px;
    height: 42px;
    border-radius: 50%;
    background: #e8ecea;
    color: var(--primary);
    font-size: var(--fontsize-16);
    font-weight: 700;
}

.memberInfo {
    flex: 1;
    min-width: 0;
}

.memberName {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 7px;
    font-size: var(--fontsize-14);
    font-weight: 600;
    color: var(--dark);
    overflow-wrap: anywhere;
}

.memberEmail {
    margin-top: 4px;
    font-size: var(--fontsize-12);
    color: #888;
    overflow-wrap: anywhere;
}

.youLabel {
    padding: 2px 6px;
    border-radius: 5px;
    background: #edf3ff;
    color: var(--primary);
    font-size: var(--fontsize-11);
    font-weight: 600;
}

.roleBadge {
    flex-shrink: 0;
    padding: 5px 9px;
    border-radius: 999px;
    background: #f0f0f0;
