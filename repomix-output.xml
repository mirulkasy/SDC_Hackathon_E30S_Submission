<file path="app/(public)/login/page.js">
"use client";

import { useEffect, useState } from "react";
import { useRouter } from "next/navigation";
import Image from "next/image";
import Link from "next/link";
import CustomInput from "@/components/input/CustomInput";
import { useAuth } from "@/context/AuthContext";
import { loginUser } from "@/lib/auth";
import styles from "./login.module.css";

const BAD_CREDENTIALS = { field: "password", msg: "Incorrect email or password." };

// Firebase now answers "auth/invalid-credential" for both a wrong password
// and an unknown email (email enumeration protection), the other two codes
// are kept for older projects.
const AUTH_ERRORS = {
  "auth/invalid-credential": BAD_CREDENTIALS,
  "auth/wrong-password": BAD_CREDENTIALS,
  "auth/user-not-found": BAD_CREDENTIALS,
  "auth/invalid-email": { field: "email", msg: "Enter a valid email address." },
  "auth/user-disabled": { field: "form", msg: "This account has been disabled." },
  "auth/too-many-requests": {
    field: "form",
    msg: "Too many attempts. Try again in a few minutes.",
  },
  "auth/network-request-failed": {
    field: "form",
    msg: "Network error. Check your connection.",
  },
};

export default function LoginPage() {
  const router = useRouter();
  const { user, profile, loading } = useAuth();
  const [values, setValues] = useState({ email: "", password: "" });
  const [errors, setErrors] = useState({});
  const [submitting, setSubmitting] = useState(false);

  // Already signed in (or just signed in): send them where they belong.
  useEffect(() => {
    if (loading || !user) return;
    router.replace(profile?.orgId ? "/home" : "/onboarding/welcome");
  }, [loading, user, profile, router]);

  const onChange = (e) =>
    setValues((v) => ({ ...v, [e.target.name]: e.target.value }));

  const validate = () => {
    const next = {};
    if (!/^\S+@\S+\.\S+$/.test(values.email.trim()))
      next.email = "Enter a valid email address.";
    if (!values.password) next.password = "Password is required.";
    return next;
  };

  const handleSubmit = async (e) => {
    e.preventDefault();
    if (submitting) return;
    const found = validate();
    setErrors(found);
    if (Object.keys(found).length) return;

    setSubmitting(true);
    try {
      await loginUser({
        email: values.email.trim(),
        password: values.password,
      });
      // No router.push here: the effect above redirects once AuthContext
      // has loaded the profile, so we know whether to go to /home or onboarding.
    } catch (err) {
      console.error(err);
      const known = AUTH_ERRORS[err.code];
      setErrors({
        [known?.field ?? "form"]:
          known?.msg ?? "Something went wrong. Please try again.",
      });
      setSubmitting(false);
    }
  };

  // Avoid flashing the form for someone who is about to be redirected
  if (loading || user) return null;

  return (
    <main className={styles.loginPage}>
      <section className={styles.header}>
        <Image
          src="/assets/biscoach/logo.png"
          alt="Biscoach"
          width={200}
          height={60}
        />
      </section>

      <h1 className={styles.title}>Welcome back</h1>

      <form className={styles.formWrapper} onSubmit={handleSubmit} noValidate>
        <CustomInput
          label="Email"
          name="email"
          type="email"
          autoComplete="email"
          value={values.email}
          onChange={onChange}
          error={errors.email}
        />
        <CustomInput
          label="Password"
          name="password"
          isPassword
          autoComplete="current-password"
          value={values.password}
          onChange={onChange}
          error={errors.password || errors.form}
        />
        <button type="submit" className={styles.loginBtn} disabled={submitting}>
          {submitting ? "Logging in..." : "Log in"}
        </button>
      </form>

      <p className={styles.switchText}>
        New here? <Link href="/onboarding">Create an account</Link>
      </p>

      <Image
        className={styles.biscoachImg}
        src="/assets/biscoach/onboarding.png"
        alt=""
        width={200}
        height={200}
      />
    </main>
  );
}
</file>

<file path="app/(public)/onboarding/organization/sales/page.js">
"use client";

import { useEffect, useState } from "react";
import { useRouter } from "next/navigation";
import Image from "next/image";
import styles from "./sales.module.css";
import { useAuth } from "@/context/AuthContext";
import { useOnboarding } from "@/context/OnboardingContext";
import { createOrganization } from "@/lib/onboarding";

const MIN_SALES = 1000;
const MAX_SALES = 100000;
const STEP = 500;

const formatRM = (n) => `RM ${n.toLocaleString("en-MY")}`;

export default function SalesPage() {
  const router = useRouter();
  const { user } = useAuth();
  const { draft } = useOnboarding();
  const [sales, setSales] = useState(10000);
  const [saving, setSaving] = useState(false);
  const [error, setError] = useState("");

  // Page refreshed mid-flow: the draft is gone, so go back a step
  useEffect(() => {
    if (!draft.orgName || !draft.businessType) {
      router.replace("/onboarding/organization");
    }
  }, [draft, router]);

  const handleFinish = async () => {
    if (saving) return;
    setSaving(true);
    setError("");
    try {
      await createOrganization({
        user,
        name: draft.orgName.trim(),
        businessType: draft.businessType,
        monthlySalesRM: sales,
      });
      router.push("/home");
    } catch (err) {
      console.error(err);
      setError("Couldn't create your workspace. Please try again.");
      setSaving(false);
    }
  };
  const ratio = (sales - MIN_SALES) / (MAX_SALES - MIN_SALES);

  return (
    <main className={styles.salesPage}>
      <Image
        className={styles.salesLogo}
        src="/assets/biscoach/logo.png"
        alt="Biscoach"
        width={200}
        height={60}
      />
      <section className={styles.salesWrapper}>
        <h1>
          Set Your
          <br />
          Estimated Monthly Sales
        </h1>

        <p className={styles.hint}>
          Drag the slider to adjust your monthly sales.
        </p>

        <div className={styles.sliderBlock}>
          <div className={styles.sliderValue}>
            {formatRM(sales)}
            {sales === MAX_SALES ? "+" : ""}
          </div>

          <input
            type="range"
            className={styles.slider}
            min={MIN_SALES}
            max={MAX_SALES}
            step={STEP}
            value={sales}
            onChange={(e) => setSales(Number(e.target.value))}
            style={{ "--ratio": ratio }}
            aria-label="Estimated monthly sales"
          />

          <div className={styles.sliderLabels}>
            <span>{formatRM(MIN_SALES)}</span>
            <span>{formatRM(MAX_SALES)}+</span>
          </div>
        </div>
      </section>

      {error && (
        <p role="alert" style={{ color: "#ff3b30", position: "absolute", bottom: 80, right: 30, zIndex: 99 }}>
          {error}
        </p>
      )}
      <button
        type="button"
        className={styles.nextBtn}
        onClick={handleFinish}
        disabled={saving}
      >
        {saving ? "Saving..." : "Next"}
      </button>

      <Image
        className={styles.biscoach}
        src="/assets/biscoach/think.png"
        alt="Biscoach"
        width={200}
        height={200}
      />
      <Image
        className={styles.wave}
        src="/assets/texture/wave.png"
        alt="Biscoach"
        width={165}
        height={45}
      />
    </main>
  );
}
</file>

