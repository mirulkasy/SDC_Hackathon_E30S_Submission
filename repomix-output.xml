          <div className={styles.typeWrapper}>
            {BUSINESS_TYPES.map((type) => (
              <button
                key={type.id}
                type="button"
                aria-pressed={draft.businessType === type.id}
                className={`${styles.typeBtn} ${
                  draft.businessType === type.id ? styles.typeBtnActive : ""
                }`}
                onClick={() =>
                  setDraft((d) => ({ ...d, businessType: type.id }))
