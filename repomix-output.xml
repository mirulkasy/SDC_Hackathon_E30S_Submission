<file path="app/(protected)/publicity/publicity.module.css">
/* ── Page root ── */
.publicityPage {
    --earning: #16a34a;
    --spending: #dc2626;
    padding: 0 0 100px !important;
    background-color: #f5f7f6;
    min-height: 100svh;
}

/* ── Section 1: Top wrapper + chart ── */
.topWrapper {
    width: 100svw;
    padding: 20px;
    box-sizing: border-box;
    background-color: var(--primary);
    display: flex;
    flex-direction: column;
    gap: 10px;
    color: white;
}

.topAction {
    display: flex;
    justify-content: space-between;
    align-items: center;
}

.topAction p {
    margin: 0;
    font-size: var(--fontsize-13);
    color: #ccc;
}

.topAction button {
    background: none;
    border: none;
    color: white;
    cursor: pointer;
}

.topAction button:disabled {
    opacity: 0.3;
    cursor: default;
}

.topActionLogo {
    width: 22px;
}

.topWrapper>h1 {
    margin: 0 0 10px;
    font-size: var(--fontsize-18);
    font-weight: 600;
}

.chartCard {
    display: flex;
    flex-direction: column;
    gap: 15px;
    background-color: #134f3d;
    padding: 15px;
    box-sizing: border-box;
    border-radius: 12px;
}

.chartHeader {
    display: flex;
    flex-direction: column;
    gap: 3px;
}

.chartHeader p {
    margin: 0;
    font-size: var(--fontsize-13);
    font-weight: 500;
    color: #ccc;
}

.chartHeader h2 {
    margin: 0;
    font-size: var(--fontsize-18);
    font-weight: 700;
    color: white;
}

.changeUp,
.changeDown {
    font-size: var(--fontsize-12);
    font-weight: 600;
}

.changeUp {
    color: var(--secondary);
}

.changeDown {
    color: #f87171;
}

.chartSvg {
    display: block;
    width: 100%;
}

.chartGrid {
    stroke: #ffffff33;
    stroke-width: 1;
}

.chartAxis {
    fill: #ccc;
    font-size: 10px;
}

.chartDay {
    fill: #ccc;
    font-size: 10px;
}

.chartDayActive {
    fill: white;
    font-size: 10px;
    font-weight: 700;
}

.bar {
    fill: var(--secondary);
    opacity: 0.55;
}

.barActive {
    fill: var(--secondary);
}

.barEmpty {
    fill: #ffffff33;
}

.barHit {
    fill: transparent;
    cursor: pointer;
}

/* ── Section 2: Schedule ── */
.scheduleWrapper {
    box-sizing: border-box;
    width: 100%;
    padding: 25px 15px 0;
    display: flex;
    flex-direction: column;
    gap: 15px;
}

.sectionHeader {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
}

.sectionHeader h2 {
    margin: 0;
    font-size: var(--fontsize-18);
    font-weight: 700;
}

.sectionHeader span {
    padding: 4px 10px;
