    gross: [6600, 7900, 7100, 8800, 8000],
    net: [2900, 3600, 3100, 4000, 3500],
    prevNet: [2600, 3000, 3200, 3300, 3100],
    cashIn: [13500, 15900, 14800, 17600, 16400],
