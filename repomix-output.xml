.subTicketPage {
  padding: 0 0 100px !important;
  background-color: #f5f7f6;
  min-height: 100svh;
}

/* ── Section 1: Status ── */
.statusSection {
  box-sizing: border-box;
  width: 100%;
  padding: 20px 15px 0;
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.statusHeader {
  display: flex;
  align-items: center;
}

/* Status pill — class names match getStatusMeta() */
.statusPill {
  padding: 4px 10px;
  border-radius: 999px;
  font-size: var(--fontsize-12);
  font-weight: 600;
  white-space: nowrap;
}

.statusOpen {
  background-color: #dbeafe;
  color: #1d4ed8;
}

.statusInProgress {
  background-color: #fef3c7;
  color: #b45309;
}

.statusOnHold {
  background-color: #e5e7eb;
  color: #4b5563;
}

.statusResolved {
  background-color: #dcfce7;
  color: #15803d;
}

.statusClosed {
  background-color: #1f2937;
  color: white;
}

/* Owner status picker */
.statusChips {
  display: flex;
  flex-wrap: wrap;
  gap: 8px;
}

.statusChip {
  padding: 8px 14px;
  border: 1.5px solid #ddd;
  border-radius: 999px;
  background-color: white;
  font-size: var(--fontsize-13);
  font-weight: 600;
  color: #555;
  transition: all 0.15s;
}

.statusChip:active {
  transform: scale(0.97);
}

.statusChip:disabled {
  opacity: 0.6;
}

.statusChipActive {
  border-color: var(--primary);
  background-color: var(--primary);
  color: white;
}

.ownerNote {
  margin: 0;
  font-size: var(--fontsize-12);
  font-style: italic;
  color: #888;
}

/* ── Section 2 & 3: Cards ── */
.detailSection {
  box-sizing: border-box;
  width: 100%;
  padding: 15px;
  display: flex;
  flex-direction: column;
  gap: 10px;
}

.detailCard {
  display: flex;
  flex-direction: column;
  gap: 10px;
  box-sizing: border-box;
  width: 100%;
  padding: 15px;
  background-color: white;
  border-radius: 12px;
}

.detailCard>h2 {
