<file path="lib/publicity.js">
import {
  collection,
  doc,
  onSnapshot,
  runTransaction,
  serverTimestamp,
  setDoc,
  updateDoc,
} from "firebase/firestore";
import { db } from "./firebase";

/* ------------------------------------------------------------------ */
/* Firestore layout                                                    */
/*  organizations/{orgId}/publicity/state       -> which week we are on */
/*  organizations/{orgId}/publicityWeeks/{n}    -> views + ideas of week n */
/* ------------------------------------------------------------------ */

export const DAY_KEYS = ["mon", "tue", "wed", "thu", "fri", "sat", "sun"];
export const DAY_SHORT = ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"];
export const PLATFORMS = [
  "TikTok",
  "Instagram Reels",
  "YouTube Shorts",
  "Facebook Reels",
];

const stateRef = (orgId) =>
  doc(db, "organizations", orgId, "publicity", "state");
const weekRef = (orgId, week) =>
  doc(db, "organizations", orgId, "publicityWeeks", String(week));

/* ---- helpers ---- */

export const emptyViews = () =>
  Object.fromEntries(DAY_KEYS.map((k) => [k, null]));

// "" / undefined / NaN -> null (did not post). 0 stays 0 (posted, no views).
const cleanView = (v) => {
  if (v === "" || v === null || v === undefined) return null;
  const n = Number(v);
  return Number.isFinite(n) && n >= 0 ? Math.round(n) : null;
};

function mondayOfThisWeek() {
  const d = new Date();
  d.setHours(0, 0, 0, 0);
  d.setDate(d.getDate() - ((d.getDay() + 6) % 7));
  return d.toISOString();
}

export function weekRange(startMonday, week) {
  const a = new Date(startMonday);
  a.setDate(a.getDate() + (week - 1) * 7);
  const b = new Date(a);
  b.setDate(b.getDate() + 6);
  const f = (d) =>
    d.toLocaleDateString("en-MY", { day: "numeric", month: "short" });
  return `${f(a)} - ${f(b)}`;
}

/** Date of a given weekday inside a given week (for the date chips). */
export function dateForDay(startMonday, week, dayKey) {
  const d = new Date(startMonday);
  d.setDate(d.getDate() + (week - 1) * 7 + DAY_KEYS.indexOf(dayKey));
  return d;
}

export const weekHasViews = (w) =>
  !!w &&
  DAY_KEYS.some((k) => w.views?.[k] !== null && w.views?.[k] !== undefined);

function mapWeek(data) {
  return {
    views: { ...emptyViews(), ...(data.views ?? {}) },
    ideas: Array.isArray(data.ideas) ? data.ideas : [],
    ideasPlatform: data.ideasPlatform ?? null,
    planned: Array.isArray(data.planned) ? data.planned : [],
  };
}

/**
 * What we send to /api/posting-schedule.
 * Every week up to and including the current one that has at least one
 * number counts, so the model learns day by day, not only at week's end.
 */
export function buildHistory(weeks, currentWeek) {
  return Object.entries(weeks)
    .map(([n, w]) => ({ week: Number(n), views: w.views }))
    .filter((w) => w.week <= currentWeek && weekHasViews(w))
    .sort((a, b) => a.week - b.week);
}

/* ---- live data ---- */

/** Live state + all weeks. callback({ state, weeks }) fires once both loaded. */
export function subscribePublicity(orgId, callback) {
  let state = null;
  let weeks = {};
  let gotState = false;
  let gotWeeks = false;
  const emit = () => gotState && gotWeeks && callback({ state, weeks });

  const unsubState = onSnapshot(
    stateRef(orgId),
    (snap) => {
      state = snap.exists() ? snap.data() : null;
      gotState = true;
      emit();
    },
    (err) => console.error("Publicity state listener failed:", err),
  );

  const unsubWeeks = onSnapshot(
    collection(db, "organizations", orgId, "publicityWeeks"),
    (snap) => {
      weeks = {};
      snap.forEach((d) => (weeks[Number(d.id)] = mapWeek(d.data())));
      gotWeeks = true;
      emit();
    },
    (err) => console.error("Publicity weeks listener failed:", err),
  );

  return () => {
    unsubState();
    unsubWeeks();
  };
}

/** First visit only: creates week 1. Safe if two devices open at once. */
export async function ensurePublicity({ orgId, user }) {
  await runTransaction(db, async (tx) => {
    const snap = await tx.get(stateRef(orgId));
    if (snap.exists()) return;
    tx.set(stateRef(orgId), {
      startMonday: mondayOfThisWeek(),
      week: 1,
      postsPerWeek: 3,
      topic: "",
      platform: "TikTok",
      createdBy: user.uid,
      createdAt: serverTimestamp(),
      updatedAt: serverTimestamp(),
    });
    tx.set(weekRef(orgId, 1), {
      views: emptyViews(),
      ideas: [],
      createdAt: serverTimestamp(),
      updatedAt: serverTimestamp(),
    });
  });
}

/* ---- writes ---- */

/** postsPerWeek / topic / platform */
export async function updateSettings(orgId, patch) {
  const allowed = {};
  if (patch.postsPerWeek !== undefined)
    allowed.postsPerWeek = Math.min(
      7,
      Math.max(1, Number(patch.postsPerWeek) || 3),
    );
  if (patch.topic !== undefined)
    allowed.topic = String(patch.topic).slice(0, 1000);
  if (patch.platform !== undefined && PLATFORMS.includes(patch.platform))
    allowed.platform = patch.platform;
  await updateDoc(stateRef(orgId), {
    ...allowed,
    updatedAt: serverTimestamp(),
  });
}

/** Save one day's views (auto-save per day). "" clears it. */
export async function saveDayViews(orgId, week, dayKey, value) {
  await setDoc(
    weekRef(orgId, week),
    { views: { [dayKey]: cleanView(value) }, updatedAt: serverTimestamp() },
    { merge: true },
  );
}

/** Keep the generated video ideas so every device sees the same ones. */
export async function saveIdeas(orgId, week, { ideas, platform }) {
  await setDoc(
    weekRef(orgId, week),
    { ideas, ideasPlatform: platform, updatedAt: serverTimestamp() },
    { merge: true },
  );
}

/** The days planned for a week: [{ day, reason, confidence }] */
export async function savePlanned(orgId, week, planned) {
  await setDoc(
    weekRef(orgId, week),
    { planned, updatedAt: serverTimestamp() },
    { merge: true },
  );
}

/**
 * The "Add week" button. Runs in a transaction so two phones tapping at
 * the same time only create ONE new week.
 * Throws: "WEEK_EMPTY" (nothing entered yet) | "ALREADY_ADDED" (another device did it)
 */
export async function addNextWeek({ orgId, fromWeek }) {
  let nextWeek = fromWeek + 1;
  await runTransaction(db, async (tx) => {
    const stateSnap = await tx.get(stateRef(orgId));
    const weekSnap = await tx.get(weekRef(orgId, fromWeek));
    if (!stateSnap.exists()) throw new Error("NO_STATE");
    if (stateSnap.data().week !== fromWeek) throw new Error("ALREADY_ADDED");
    if (!weekHasViews(mapWeek(weekSnap.data() ?? {})))
      throw new Error("WEEK_EMPTY");

    nextWeek = fromWeek + 1;
    tx.update(stateRef(orgId), {
      week: nextWeek,
      updatedAt: serverTimestamp(),
    });
    tx.set(weekRef(orgId, nextWeek), {
      views: emptyViews(),
      ideas: [],
      createdAt: serverTimestamp(),
      updatedAt: serverTimestamp(),
    });
  });
  return nextWeek;
}
</file>

<file path="lib/summary.js">
import {
  Timestamp,
  collection,
  onSnapshot,
  query,
  where,
} from "firebase/firestore";
import { db } from "./firebase";
import { getCategoryColor } from "./transactions";

const toDate = (v) => (v?.toDate ? v.toDate() : v ? new Date(v) : null);
const mondayIndex = (d) => (d.getDay() + 6) % 7;
const sameDay = (a, b) =>
  a.getFullYear() === b.getFullYear() &&
  a.getMonth() === b.getMonth() &&
  a.getDate() === b.getDate();
const fmtDay = (d) =>
  d.toLocaleDateString("en-MY", { day: "numeric", month: "short" });

const CATEGORY_LABELS = {
  sales: "Sales",
  stock_purchase: "Stock Purchase",
  rent: "Rent",
  utilities: "Utilities",
  salary: "Salary",
  marketing: "Marketing",
  platform_fee: "Platform Fee",
  tax: "Tax",
  other: "Other",
};

const categoryLabel = (key) =>
  CATEGORY_LABELS[key] ??
  key.replace(/_/g, " ").replace(/\b\w/g, (c) => c.toUpperCase());

/**
 * One definition per filter: the current range, the previous range of the
 * same length (prevStart = null means no comparison), the x-axis labels and
 * which bucket a date falls into.
 */
export function getPeriod(key, now = new Date()) {
  const y = now.getFullYear();
  const m = now.getMonth();
  const d = now.getDate();

  switch (key) {
    case "daily":
      return {
        title: "Today",
        note: new Date(y, m, d).toLocaleDateString("en-MY", {
          day: "numeric",
          month: "long",
          year: "numeric",
        }),
        labels: ["12am", "4am", "8am", "12pm", "4pm", "8pm"],
        start: new Date(y, m, d),
        end: new Date(y, m, d + 1),
        prevStart: new Date(y, m, d - 1),
        // Manual entries are saved at midnight, so use the time the entry
        // was created when it was made on the same day.
        bucket: (date, created) =>
          Math.floor(
            (created && sameDay(created, date) ? created : date).getHours() / 4,
          ),
      };

    case "weekly": {
      const i = mondayIndex(now);
      return {
        title: "This Week",
        note: `${fmtDay(new Date(y, m, d - i))} – ${fmtDay(new Date(y, m, d - i + 6))}`,
        labels: ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"],
        start: new Date(y, m, d - i),
        end: new Date(y, m, d - i + 7),
        prevStart: new Date(y, m, d - i - 7),
        bucket: (date) => mondayIndex(date),
      };
    }

    case "annual":
      return {
        title: "This Year",
        note: `Jan – Dec ${y}`,
        labels: ["Q1", "Q2", "Q3", "Q4"],
        start: new Date(y, 0, 1),
        end: new Date(y + 1, 0, 1),
        prevStart: new Date(y - 1, 0, 1),
        bucket: (date) => Math.floor(date.getMonth() / 3),
      };

    case "all":
      return {
        title: "All Time",
        note: `${y - 4} – ${y}`,
        labels: Array.from({ length: 5 }, (_, i) => String(y - 4 + i)),
        start: new Date(y - 4, 0, 1),
        end: new Date(y + 1, 0, 1),
        prevStart: null,
        bucket: (date) => date.getFullYear() - (y - 4),
      };

    default: // monthly
      return {
        title: "This Month",
        note: new Date(y, m, 1).toLocaleDateString("en-MY", {
          month: "long",
          year: "numeric",
        }),
        labels: ["W1", "W2", "W3", "W4", "W5"],
        start: new Date(y, m, 1),
        end: new Date(y, m + 1, 1),
        prevStart: new Date(y, m - 1, 1),
        bucket: (date) => Math.min(4, Math.floor((date.getDate() - 1) / 7)),
      };
  }
}

function isVisible(data) {
  return !data.deletedAt && data.status !== "pending_review";
}

function summarise(p, rows) {
  const zeros = () => p.labels.map(() => 0);
  const sales = zeros();
  const spending = zeros();
  const purchases = zeros();
  const prevSales = zeros();
  const prevSpending = zeros();
  const categories = {};

  for (const r of rows) {
    const date = toDate(r.date);
    if (!date) continue;
    const i = p.bucket(date, toDate(r.createdAt));
    if (i < 0 || i >= p.labels.length) continue;

    const amount = (r.amount ?? 0) / 100; // sen -> RM
    const isCurrent = date >= p.start;

    if (r.type === "in") {
      (isCurrent ? sales : prevSales)[i] += amount;
    } else if (r.type === "out") {
      (isCurrent ? spending : prevSpending)[i] += amount;
      if (isCurrent) {
        if (r.category === "stock_purchase") purchases[i] += amount;
        const cat = r.category ?? "other";
        categories[cat] = (categories[cat] ?? 0) + amount;
      }
    }
  }

  // Spending breakdown: top 4 categories, the rest grouped as "Others"
  const sorted = Object.entries(categories).sort((a, b) => b[1] - a[1]);
  const total = sorted.reduce((s, [, v]) => s + v, 0);
  const pct = (v) => Math.round((v / total) * 1000) / 10;
  const breakdown = sorted.slice(0, 4).map(([key, value]) => ({
    name: categoryLabel(key),
    percent: pct(value),
    color: getCategoryColor(key),
  }));
  const rest = sorted.slice(4).reduce((s, [, v]) => s + v, 0);
  if (rest > 0) {
    breakdown.push({ name: "Others", percent: pct(rest), color: "#cbd5e1" });
  }

  return {
    title: p.title,
    note: p.note,
    labels: p.labels,
    hasPrev: Boolean(p.prevStart),
    sales,
    spending,
    // No cost-of-goods data, so stock purchases stand in for it
    gross: sales.map((s, i) => s - purchases[i]),
    net: sales.map((s, i) => s - spending[i]),
    prevSales,
    prevSpending,
    prevNet: prevSales.map((s, i) => s - prevSpending[i]),
    breakdown,
  };
}

/** Zeros with the right labels, shown until the first snapshot arrives. */
export function blankSummary(key) {
  return summarise(getPeriod(key), []);
}

/** Live summary for one filter. Returns the unsubscribe function. */
export function subscribeSummary(orgId, key, callback) {
  const p = getPeriod(key);
  // One range query covers the current AND previous period (date only,
  // so no composite index is needed).
  const q = query(
    collection(db, "organizations", orgId, "transactions"),
    where("date", ">=", Timestamp.fromDate(p.prevStart ?? p.start)),
    where("date", "<", Timestamp.fromDate(p.end)),
  );

  return onSnapshot(
    q,
    (snap) => {
      const rows = snap.docs.map((d) => d.data()).filter(isVisible);
      callback(summarise(p, rows));
    },
    (err) => console.error("Summary listener failed:", err),
  );
}
