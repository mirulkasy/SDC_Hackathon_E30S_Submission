/* ── Page root ── */
.transactionPage {
    --earning: #16a34a;
    --spending: #dc2626;
    padding: 0 0 100px !important;
    background-color: #f5f7f6;
    min-height: 100svh;
}

.stickyWrapper {
    z-index: 999;
    position: sticky;
    top: 0;
    will-change: transform;
}

/* ── Section 1: Month filter ── */
