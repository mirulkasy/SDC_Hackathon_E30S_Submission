<file path="lib/tickets.js">
import {
  addDoc,
  collection,
  doc,
  getDoc,
  onSnapshot,
  orderBy,
  query,
  runTransaction,
  serverTimestamp,
  updateDoc,
} from "firebase/firestore";
import { db } from "./firebase";

/* ------------------------------------------------------------------ */
/* Tickets live at organizations/{orgId}/tickets                       */
/* Statuses: open | in_progress | on_hold | resolved | closed          */
/* ------------------------------------------------------------------ */

export const TICKET_CATEGORIES = [
  { value: "cash_flow", label: "Cash Flow" },
  { value: "inventory", label: "Inventory" },
  { value: "invoice", label: "Invoice" },
  { value: "account", label: "Account" },
  { value: "bug", label: "Bug" },
  { value: "other", label: "Other" },
];

export const TICKET_PRIORITIES = [
  { value: "low", label: "Low" },
  { value: "medium", label: "Medium" },
  { value: "high", label: "High" },
];

export const TICKET_STATUSES = [
  { value: "open", label: "Open" },
  { value: "in_progress", label: "In Progress" },
  { value: "on_hold", label: "On Hold" },
  { value: "resolved", label: "Resolved" },
  { value: "closed", label: "Closed" },
];

/* ---- Display metadata (label + CSS class name) ---- */

const STATUS_META = {
  open: { label: "Open", className: "statusOpen" },
  in_progress: { label: "In Progress", className: "statusInProgress" },
  on_hold: { label: "On Hold", className: "statusOnHold" },
  resolved: { label: "Resolved", className: "statusResolved" },
  closed: { label: "Closed", className: "statusClosed" },
};

const PRIORITY_META = {
  low: { label: "Low", className: "priorityLow" },
  medium: { label: "Medium", className: "priorityMedium" },
  high: { label: "High", className: "priorityHigh" },
};

export function getStatusMeta(status) {
  return STATUS_META[status] ?? STATUS_META.open;
}

export function getPriorityMeta(priority) {
  return PRIORITY_META[priority] ?? PRIORITY_META.medium;
}

export function getCategoryLabel(category) {
  return TICKET_CATEGORIES.find((c) => c.value === category)?.label ?? "Other";
}

/* ---- Mapping: Firestore doc -> UI shape ---- */

function toDate(value) {
  if (!value) return null;
  return value.toDate ? value.toDate() : new Date(value);
}

export function formatTicketDate(value) {
  const date = toDate(value);
  if (!date) return "";
  return date.toLocaleString("en-MY", {
    day: "numeric",
    month: "short",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  });
}

export function mapTicket(id, data) {
  const created = toDate(data.createdAt);
  const resolved = toDate(data.resolvedAt);
  return {
    id,
    ticketNo: data.ticketNo ?? id.slice(0, 6).toUpperCase(),
    title: data.title ?? "-",
    description: data.description ?? "",
    category: data.category ?? "other",
    status: data.status ?? "open",
    priority: data.priority ?? "medium",
    reportedBy: data.reportedBy ?? { uid: null, name: "Unknown" },
    transactionId: data.transactionId ?? null,
    createdLabel: created ? formatTicketDate(created) : "",
    resolvedLabel: resolved ? formatTicketDate(resolved) : "",
  };
}

/* ---- Queries ---- */

/** Live ticket list, newest first. */
export function subscribeTickets(orgId, callback) {
  const q = query(
    collection(db, "organizations", orgId, "tickets"),
    orderBy("createdAt", "desc"),
  );
  return onSnapshot(
    q,
    (snap) => {
      callback(snap.docs.map((d) => mapTicket(d.id, d.data())));
    },
    (err) => console.error("Tickets listener failed:", err),
  );
}

/** One-time read of a single ticket (detail page). */
export async function getTicket(orgId, ticketId) {
  const snap = await getDoc(
    doc(db, "organizations", orgId, "tickets", ticketId),
  );
  if (!snap.exists()) return null;
  return mapTicket(snap.id, snap.data());
}

/**
 * Create a ticket. The friendly number (TKT-0001, ...) comes from
 * counters/ticketNo, incremented safely inside a transaction so two
 * people submitting at once never get the same number.
 */
export async function addTicket({ orgId, user, ticket }) {
  const counterRef = doc(db, "organizations", orgId, "counters", "ticketNo");
  let ticketNo = "TKT-0001";
  await runTransaction(db, async (tx) => {
    const snap = await tx.get(counterRef);
    const current = snap.exists() ? snap.data().value ?? 0 : 0;
    const next = current + 1;
    tx.set(counterRef, { value: next, updatedAt: serverTimestamp() });
    ticketNo = `TKT-${String(next).padStart(4, "0")}`;
  });

  const ref = await addDoc(collection(db, "organizations", orgId, "tickets"), {
    ticketNo,
    title: ticket.title.trim(),
    description: ticket.description.trim(),
    category: ticket.category,
    priority: ticket.priority,
    status: "open",
    reportedBy: {
      uid: user.uid,
      name: user.displayName ?? "Unknown",
    },
    transactionId: ticket.transactionId ?? null,
    createdAt: serverTimestamp(),
    updatedAt: serverTimestamp(),
  });
  return ref.id;
}

/**
 * Change the status. Stamps resolvedAt when the ticket reaches a
 * terminal state so the UI can show when it was closed out.
 */
export async function updateTicketStatus({ orgId, ticketId, status }) {
  const terminal = status === "resolved" || status === "closed";
  await updateDoc(doc(db, "organizations", orgId, "tickets", ticketId), {
    status,
    resolvedAt: terminal ? serverTimestamp() : null,
    updatedAt: serverTimestamp(),
  });
}
</file>

<file path="lib/transactions.js">
import {
  Timestamp,
  collection,
  doc,
  addDoc,
  serverTimestamp,
  getDoc,
  onSnapshot,
  query,
  where,
} from "firebase/firestore";
import { db } from "./firebase";

/* ------------------------------------------------------------------ */
/* Money — schema stores integer sen: RM 12.50 = 1250                  */
/* ------------------------------------------------------------------ */

export function senToRM(sen) {
  return (sen ?? 0) / 100;
}

export function formatRMFromSen(sen) {
  return `RM ${senToRM(sen).toLocaleString("en-MY", {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  })}`;
}

/** Ringgit formatter for UI-ready numbers (used by mapped transactions). */
export function formatRM(value) {
  return `RM ${value.toLocaleString("en-MY", {
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  })}`;
}

/* ------------------------------------------------------------------ */
/* Date ranges                                                         */
/* ------------------------------------------------------------------ */

function todayRange() {
  const now = new Date();
  const start = new Date(now.getFullYear(), now.getMonth(), now.getDate());
  const end = new Date(start);
  end.setDate(end.getDate() + 1);
  return { start: Timestamp.fromDate(start), end: Timestamp.fromDate(end) };
}

/** [start, end) Timestamps covering one "yyyy-MM" month key. */
function monthRange(monthKey) {
  const [year, month] = monthKey.split("-").map(Number);
  return {
    start: Timestamp.fromDate(new Date(year, month - 1, 1)),
    end: Timestamp.fromDate(new Date(year, month, 1)),
  };
}

/** The last `count` "yyyy-MM" keys, oldest first (for the month bar). */
export function recentMonthKeys(count = 12) {
  const keys = [];
  const now = new Date();
  for (let i = count - 1; i >= 0; i--) {
    const d = new Date(now.getFullYear(), now.getMonth() - i, 1);
    keys.push(
      `${d.getFullYear()}-${String(d.getMonth() + 1).padStart(2, "0")}`,
    );
  }
  return keys;
}

/* ------------------------------------------------------------------ */
/* Mapping: Firestore doc -> the shape the UI already uses             */
/* ------------------------------------------------------------------ */

export function mapTransaction(id, data) {
  const date = data.date?.toDate ? data.date.toDate() : new Date(data.date);
  return {
    id,
    title: data.description ?? "-",
    category: data.category ?? "other",
    // schema: "in" | "out"  ->  UI: "earning" | "spending"
    type: data.type === "in" ? "earning" : "spending",
    amount: senToRM(data.amount),
    date: date.toISOString(),
    method: data.paymentMethod ?? "-",
    reference: id,
    note: data.note ?? "",
  };
}

function isVisible(data) {
  return !data.deletedAt && data.status !== "pending_review";
}

/* ------------------------------------------------------------------ */
/* Queries                                                             */
/* ------------------------------------------------------------------ */

/** Live daily totals for the home page. */
export function subscribeDailyStats(orgId, callback) {
  const { start, end } = todayRange();
  const q = query(
    collection(db, "organizations", orgId, "transactions"),
    where("date", ">=", start),
    where("date", "<", end),
  );

  return onSnapshot(
    q,
    (snap) => {
      let sales = 0;
      let spending = 0;
      snap.forEach((doc) => {
        const d = doc.data();
        if (!isVisible(d)) return;
        if (d.type === "in") sales += d.amount ?? 0;
        else if (d.type === "out") spending += d.amount ?? 0;
      });
      callback({ sales, spending, profit: sales - spending, loaded: true });
    },
    (err) => console.error("Daily stats listener failed:", err),
  );
}

/** All confirmed transactions of one month, newest first. */
export function subscribeMonthTransactions(orgId, monthKey, callback) {
  const { start, end } = monthRange(monthKey);
  const q = query(
    collection(db, "organizations", orgId, "transactions"),
    where("date", ">=", start),
    where("date", "<", end),
  );

  return onSnapshot(
    q,
    (snap) => {
      const items = [];
      snap.forEach((doc) => {
        const data = doc.data();
        if (!isVisible(data)) return;
        items.push(mapTransaction(doc.id, data));
      });
      items.sort((a, b) => new Date(b.date) - new Date(a.date));
      callback(items);
    },
    (err) => console.error("Transaction listener failed:", err),
  );
}

/** One-time read of a single transaction (detail page). */
export async function getTransaction(orgId, txId) {
  const snap = await getDoc(
    doc(db, "organizations", orgId, "transactions", txId),
  );
  if (!snap.exists()) return null;
  const data = snap.data();
  if (!isVisible(data)) return null;
  return mapTransaction(snap.id, data);
}

/** Add one confirmed transaction. Amount arrives in RM and is stored as sen. */
export async function addTransaction({ orgId, user, transaction }) {
  const { type, amount, category, description, date, paymentMethod, note } =
    transaction;

  await addDoc(collection(db, "organizations", orgId, "transactions"), {
    type, // "in" | "out"
    amount: Math.round(amount * 100), // integer sen, matches the schema
    category,
    description: description.trim(),
    // date input gives "YYYY-MM-DD"; keep it at local midnight
    date: Timestamp.fromDate(new Date(`${date}T00:00:00`)),
    paymentMethod,
    note: note?.trim() ?? "",
    status: "confirmed",
    createdBy: user.uid,
    createdAt: serverTimestamp(),
    updatedAt: serverTimestamp(),
  });
}

/* ------------------------------------------------------------------ */
/* Display helpers (moved from data/transactions.js)                   */
/* ------------------------------------------------------------------ */

export const categoryColors = {
  Salary: "#2563eb",
  Freelance: "#7c3aed",
  Investment: "#0891b2",
  Bonus: "#f59e0b",
  Food: "#e11d48",
  Transport: "#312e81",
  Utilities: "#0d9488",
  Entertainment: "#ea580c",
  Shopping: "#7d909b",
  // cash-flow schema categories
  sales: "#059669",
  stock_purchase: "#e11d48",
  rent: "#312e81",
  utilities: "#0d9488",
  salary: "#2563eb",
  marketing: "#ea580c",
  platform_fee: "#7d909b",
  tax: "#f59e0b",
  other: "#7d909b",
};

export function getCategoryColor(category) {
  return categoryColors[category] || "#7d909b";
}

export function formatAmount(item) {
  const sign = item.type === "earning" ? "+" : "-";
  return `${sign} ${formatRM(item.amount)}`;
}

export function formatDate(value) {
  return new Date(value).toLocaleString("en-MY", {
    day: "numeric",
    month: "short",
    year: "numeric",
    hour: "2-digit",
    minute: "2-digit",
  });
}
