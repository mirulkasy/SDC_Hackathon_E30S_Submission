  const orgId = profile?.orgId;

  const [products, setProducts] = useState([]);
  const [loaded, setLoaded] = useState(false);
  const [search, setSearch] = useState("");
  const [category, setCategory] = useState("All");
  const [showFilter, setShowFilter] = useState(false);

  useEffect(() => {
    if (!orgId) return;
    setLoaded(false);
    return subscribeProducts(orgId, (items) => {
      setProducts(items);
      setLoaded(true);
    });
  }, [orgId]);

  // Categories come from the real data now, not a placeholder array
  const categories = useMemo(
    () => ["All", ...new Set(products.map((p) => p.category))],
    [products],
  );

  const filtered = products.filter(
    (p) =>
      p.name.toLowerCase().includes(search.toLowerCase()) &&
      (category === "All" || p.category === category),
  );

  return (
    <>
      <AppBar
        title="Inventory"
        actionIcon={
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            strokeWidth="1.5"
            stroke="currentColor"
            width={22}
            height={22}
          >
            <path
              strokeLinecap="round"
              strokeLinejoin="round"
              d="M12 4.5v15m7.5-7.5h-15"
            />
          </svg>
        }
        onAction={() => router.push("/inventory/add")}
      />
      <main className={styles.inventoryPage}>
        {/* ── Section 2: Search & Filter ── */}
        <section className={styles.searchBar}>
          <div className={styles.searchRow}>
            <div className={styles.searchBox}>
              <svg
                className={styles.searchLogo}
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                strokeWidth="1.5"
                stroke="currentColor"
              >
                <path
                  strokeLinecap="round"
                  strokeLinejoin="round"
                  d="m21 21-5.197-5.197m0 0A7.5 7.5 0 1 0 5.196 5.196a7.5 7.5 0 0 0 10.607 10.607Z"
                />
              </svg>
              <input
                type="text"
                placeholder="Search product"
                value={search}
                onChange={(e) => setSearch(e.target.value)}
              />
            </div>
            <button
              className={`${styles.filterButton} ${showFilter ? styles.filterActive : ""}`}
              onClick={() => setShowFilter(!showFilter)}
              aria-label="Filter by category"
            >
              <svg
                className={styles.filterActionLogo}
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                strokeWidth="1.5"
                stroke="currentColor"
              >
                <path
                  strokeLinecap="round"
                  strokeLinejoin="round"
                  d="M12 3c2.755 0 5.455.232 8.083.678.533.09.917.556.917 1.096v1.044a2.25 2.25 0 0 1-.659 1.591l-5.432 5.432a2.25 2.25 0 0 0-.659 1.591v2.927a2.25 2.25 0 0 1-1.244 2.013L9.75 21v-6.568a2.25 2.25 0 0 0-.659-1.591L3.659 7.409A2.25 2.25 0 0 1 3 5.818V4.774c0-.54.384-1.006.917-1.096A48.32 48.32 0 0 1 12 3Z"
                />
              </svg>
            </button>
          </div>

          {showFilter && (
            <div className={styles.categoryList}>
              {categories.map((c) => (
                <button
                  key={c}
                  className={`${styles.categoryChip} ${category === c ? styles.categoryActive : ""}`}
                  onClick={() => setCategory(c)}
                >
                  {c}
                </button>
              ))}
            </div>
          )}
        </section>

        {/* ── Section 3: Product Grid ── */}
        <section className={styles.inventory}>
          <div className={styles.productGrid}>
            {filtered.map((p) => (
              <Link
                key={p.id}
                href={`/inventory/${p.id}`}
                className={styles.productCard}
              >
                {p.imageUrl && (
                  <Image
                    src={p.imageUrl}
                    alt={p.name}
                    width={150}
                    height={150}
                  />
                )}
                <div className={styles.productInfo}>
                  <span className={styles.productCategory}>{p.category}</span>
                  <h2>{p.name}</h2>
                  <p className={styles.productPrice}>RM {p.price.toFixed(2)}</p>
                  <p
                    className={`${styles.productStock} ${p.stock <= LOW_STOCK_THRESHOLD ? styles.lowStock : ""}`}
                  >
                    {p.stock === 0 ? "Out of stock" : `${p.stock} left`}
                  </p>
                </div>
              </Link>
            ))}
          </div>
          {!loaded && <p className={styles.emptyText}>Loading...</p>}
          {loaded && filtered.length === 0 && (
            <p className={styles.emptyText}>No products found</p>
          )}
        </section>
      </main>

      <NavBar />
    </>
  );
}
</file>

<file path="app/(protected)/profile/page.js">
"use client";

import { useEffect, useState } from "react";
import Link from "next/link";
import { signOut } from "firebase/auth";
import { doc, onSnapshot } from "firebase/firestore";
import { auth, db } from "@/lib/firebase";
import { useAuth } from "@/context/AuthContext";
import { BUSINESS_TYPES } from "@/lib/businessTypes";
import { updateOrganization, updateUserName } from "@/lib/profile";
import NavBar from "@/components/layout/NavBar";
import styles from "./profile.module.css";
import AppBar from "@/components/layout/AppBar";

export default function ProfilePage() {
  const { user, profile } = useAuth();
  const [org, setOrg] = useState(null);
  const [copied, setCopied] = useState(false);

  // null = untouched, so the field always shows the latest saved value
  const [nameDraft, setNameDraft] = useState(null);
  const [orgDraft, setOrgDraft] = useState(null);
  const [savingName, setSavingName] = useState(false);
  const [savingOrg, setSavingOrg] = useState(false);
  const [nameError, setNameError] = useState("");
  const [orgError, setOrgError] = useState("");

  const orgId = profile?.orgId;
  const isOwner = profile?.role === "owner";

  useEffect(() => {
    if (!orgId) return;
    return onSnapshot(
      doc(db, "organizations", orgId),
      (snap) => setOrg(snap.exists() ? snap.data() : null),
      (err) => console.error("Organization listener failed:", err),
    );
  }, [orgId]);

  useEffect(() => {
    if (!copied) return;
    const timer = setTimeout(() => setCopied(false), 2000);
    return () => clearTimeout(timer);
  }, [copied]);

  const nameValue = nameDraft ?? profile?.name ?? "";
  const nameDirty =
    nameDraft !== null && nameDraft.trim() !== (profile?.name ?? "");

  const orgNameValue = orgDraft?.name ?? org?.name ?? "";
  const businessTypeValue = orgDraft?.businessType ?? org?.businessType ?? "";
  const orgDirty =
    orgDraft !== null &&
    (orgNameValue.trim() !== (org?.name ?? "") ||
      businessTypeValue !== (org?.businessType ?? ""));

  const typeLabel =
    BUSINESS_TYPES.find((t) => t.id === org?.businessType)?.label ?? "-";

  const editOrg = (patch) =>
    setOrgDraft((d) => ({
      name: orgNameValue,
      businessType: businessTypeValue,
      ...d,
      ...patch,
    }));

  const handleCopy = async () => {
    if (!org?.inviteCode) return;
    try {
      await navigator.clipboard.writeText(org.inviteCode);
      setCopied(true);
    } catch (err) {
      console.error("Copy failed:", err);
    }
  };

  const handleSaveName = async (e) => {
    e.preventDefault();
    if (!nameValue.trim()) return setNameError("Name is required.");
    setNameError("");
    setSavingName(true);
    try {
      await updateUserName({ user, orgId, name: nameValue.trim() });
      setNameDraft(null);
    } catch (err) {
      console.error(err);
      setNameError("Couldn’t save your name. Please try again.");
    } finally {
      setSavingName(false);
    }
  };

  const handleSaveOrg = async (e) => {
    e.preventDefault();
    if (!orgNameValue.trim())
      return setOrgError("Organization name is required.");
    if (!businessTypeValue) return setOrgError("Pick a business type.");
    setOrgError("");
    setSavingOrg(true);
    try {
      await updateOrganization({
        orgId,
        name: orgNameValue.trim(),
        businessType: businessTypeValue,
      });
      setOrgDraft(null);
    } catch (err) {
      console.error(err);
      setOrgError("Couldn’t save the organization. Please try again.");
    } finally {
      setSavingOrg(false);
    }
  };

  const initial = (profile?.name ?? "?").trim().charAt(0).toUpperCase();

  return (
    <>
      <AppBar title="Profile" />
      <main className={styles.profilePage}>
        {/* ── Section 1: Organization code banner ── */}
        <section className={styles.codeWrapper}>
          <div className={styles.codeBanner}>
            <div className={styles.codeInfo}>
              <h1>Organization Code</h1>
              <p>
                {isOwner
                  ? "Share the organization code above so your team can join."
                  : "Only the owner can edit organization details."}
              </p>
              <h2>{org?.inviteCode ?? "--------"}</h2>
            </div>
            <button
              type="button"
              className={styles.copyBtn}
              onClick={handleCopy}
              disabled={!org?.inviteCode}
            >
              {copied ? "Copied" : "Copy"}
            </button>
          </div>
        </section>

        {/* ── Section 3: Account ── */}
        <form className={styles.section} onSubmit={handleSaveName}>
          <h2 className={styles.sectionTitle}>Account</h2>
          <div className={styles.card}>
            <label className={styles.field}>
              <span className={styles.fieldLabel}>Name</span>
              <input
                className={styles.fieldInput}
                name="name"
                autoComplete="name"
                value={nameValue}
                onChange={(e) => setNameDraft(e.target.value)}
              />
            </label>
            <div className={styles.field}>
              <span className={styles.fieldLabel}>Email</span>
              <p className={`${styles.fieldText} ${styles.emailText}`}>
                {profile?.email ?? user?.email}
              </p>
            </div>
          </div>
          <p
            className={styles.errorText}
            role={nameError ? "alert" : undefined}
          >
            {nameError}
          </p>
          {nameDirty && (
            <button
              type="submit"
              className={styles.saveBtn}
              disabled={savingName}
            >
              {savingName ? "Saving..." : "Save"}
            </button>
          )}
        </form>

        {/* ── Section 4: Organization ── */}
        <form className={styles.section} onSubmit={handleSaveOrg}>
          <h2 className={styles.sectionTitle}>Organization</h2>
          <div className={styles.card}>
            {isOwner ? (
              <>
                <label className={styles.field}>
                  <span className={styles.fieldLabel}>Organization Name</span>
                  <input
                    className={styles.fieldInput}
                    name="orgName"
                    autoComplete="organization"
                    value={orgNameValue}
                    onChange={(e) => editOrg({ name: e.target.value })}
                  />
                </label>
                <div className={styles.field}>
                  <span className={styles.fieldLabel}>Business Type</span>
                  <div className={styles.typeWrapper}>
                    {BUSINESS_TYPES.map((type) => (
                      <button
                        key={type.id}
                        type="button"
                        aria-pressed={businessTypeValue === type.id}
                        className={`${styles.typeBtn} ${
                          businessTypeValue === type.id
                            ? styles.typeBtnActive
                            : ""
                        }`}
                        onClick={() => editOrg({ businessType: type.id })}
                      >
                        {type.label}
                      </button>
                    ))}
                  </div>
                </div>
              </>
            ) : (
              <>
                <div className={styles.field}>
                  <span className={styles.fieldLabel}>Organization Name</span>
                  <p className={styles.fieldText}>{org?.name ?? "-"}</p>
                </div>
                <div className={styles.field}>
                  <span className={styles.fieldLabel}>Business Type</span>
                  <p className={styles.fieldText}>{typeLabel}</p>
                </div>
              </>
            )}
          </div>
          <p className={styles.errorText} role={orgError ? "alert" : undefined}>
            {orgError}
          </p>
          {isOwner && orgDirty && (
            <button
              type="submit"
              className={styles.saveBtn}
              disabled={savingOrg}
            >
              {savingOrg ? "Saving..." : "Save"}
            </button>
          )}
        </form>

        {/* ── Section 5: Log out ── */}
        <section className={styles.section}>
          <button
            type="button"
            className={styles.logoutBtn}
            onClick={() => signOut(auth)}
          >
            <svg
              className={styles.logoutLogo}
              xmlns="http://www.w3.org/2000/svg"
              fill="none"
              viewBox="0 0 24 24"
              strokeWidth="1.5"
              stroke="currentColor"
            >
              <path
                strokeLinecap="round"
                strokeLinejoin="round"
                d="M15.75 9V5.25A2.25 2.25 0 0 0 13.5 3h-6a2.25 2.25 0 0 0-2.25 2.25v13.5A2.25 2.25 0 0 0 7.5 21h6a2.25 2.25 0 0 0 2.25-2.25V15m3 0 3-3m0 0-3-3m3 3H9"
              />
            </svg>
            Log Out
          </button>
        </section>
      </main>

      <NavBar />
    </>
  );
}
</file>

<file path="app/(protected)/profile/profile.module.css">
.profilePage {
    padding: 10px 0 150px !important;
    background-color: #f5f7f6;
    min-height: 100svh;
}

/* ── Section 1: Organization code banner ── */
.codeWrapper {
    padding: 10px 15px;
    box-sizing: border-box;
}

.codeBanner {
    position: relative;
    box-sizing: border-box;
    padding: 20px 15px;
    border-radius: 12px;
    background-color: #134f3d;
    width: 100%;

    display: flex;
    flex-direction: column;
    gap: 10px;
    overflow: hidden;
}

.codeInfo {
    display: flex;
    flex-direction: column;
    gap: 2px;
}

.codeInfo h1 {
    font-size: var(--fontsize-16);
    font-weight: 600;
    color: white;
}

.codeInfo p {
    padding: 5px 0;
    width: 80%;
    font-size: var(--fontsize-14);
    font-style: italic;
    font-weight: 500;
    color: #ccc;
}

.codeInfo h2 {
    margin-top: 10px;
    padding: 10px 8px;
    border-radius: 5px;
    background-color: rgba(0,0,0,0.3);
    border-left: 4px solid white;
    font-size: var(--fontsize-20);
    font-weight: 500;
    letter-spacing: 0.15em;
    color: white;
}

.copyBtn {
    margin-top: 5px;
    width: fit-content;
    background-color: white;
    border-radius: 999px;
    padding: 8px 16px;
    font-weight: 600;
    font-size: var(--fontsize-13);
}

.copyBtn:disabled {
    opacity: 0.5;
    cursor: default;
}

/* ── Sections 3-5: Cards ── */
.section {
    box-sizing: border-box;
    width: 100%;
    padding: 15px 15px 0;
    display: flex;
    flex-direction: column;
    gap: 8px;
}

.sectionTitle {
    margin: 0 0 0 5px;
    font-size: var(--fontsize-14);
    font-weight: 600;
    color: var(--primary);
}

.card {
    box-sizing: border-box;
    width: 100%;
    background-color: white;
    border-radius: 12px;
    overflow: hidden;
}

/* Telegram-style row: small label on top, value below, divider between rows */
.field {
    position: relative;
    box-sizing: border-box;
    padding: 12px 45px 12px 15px;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 4px;
    border-bottom: 1px solid #f0f0f0;
}

.field:last-child {
    border-bottom: none;
}

.fieldLabel {
    font-size: var(--fontsize-13);
    font-weight: 700;
    color: var(--primary);
}

/* Borderless input that reads like plain text until tapped */
.fieldInput {
    box-sizing: border-box;
    width: 100%;
    height: auto;
    padding: 0;
    background-color: transparent;
    border: none;
    border-radius: 0;
    font-family: inherit;
    font-size: var(--fontsize-16);
    font-weight: 500;
    color: var(--dark);
    cursor: text;
    user-select: text;
}

.fieldText {
    font-size: var(--fontsize-16);
    font-weight: 500;
    color: var(--dark);
    word-break: break-all;
}

.emailText {
    color: #ccc;
}

.typeWrapper {
    padding: 6px 0 2px;
    display: flex;
    flex-direction: row;
    flex-wrap: wrap;
    gap: 8px;
}

.typeBtn {
    flex: 1 1 auto;
    padding: 8px 10px;
    background-color: white;
    border: 2px solid var(--primary);
    color: var(--primary);
    font-size: var(--fontsize-13);
    font-weight: 600;
    border-radius: 999px;
    text-align: center;
}

.typeBtnActive {
    background-color: var(--primary);
    color: white;
}

.hint {
    margin: 0 0 0 5px;
    font-size: var(--fontsize-12);
    color: #888;
}

.errorText {
    margin: 0 0 0 5px;
    font-size: var(--fontsize-12);
    font-weight: 500;
    color: #ff3b30;
}

.errorText:empty {
    display: none;
}

.saveBtn {
    align-self: flex-end;
    background-color: var(--primary);
    color: white;
    border-radius: 999px;
    padding: 10px 24px;
    font-size: var(--fontsize-14);
    font-weight: 600;
}

.saveBtn:disabled {
    opacity: 0.6;
    cursor: default;
}

.logoutBtn {
    margin-top: 30px;
    border-radius: 12px;
    border: 2px solid #ff3b30;
    box-sizing: border-box;
    width: 100%;
    padding: 10px 15px;
    font-size: var(--fontsize-14);
    font-weight: 500;
    color: #ff3b30;

    display: flex;
    gap: 10px;
    align-items: center;
    justify-content: center;
}

.logoutLogo {
    width: 22px;
}
